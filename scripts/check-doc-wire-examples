#!/usr/bin/env python3
"""Validate Wire code fences embedded in Markdown docs."""

from __future__ import annotations

import argparse
import re
import subprocess
import sys
import tempfile
from dataclasses import dataclass
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
DOCS = ROOT / "docs"
GRAMMAR_DIR = ROOT / "editors" / "tree-sitter-wire"
FENCE_RE = re.compile(r"^```([A-Za-z0-9_-]+)?(?:\s.*)?$")


@dataclass(frozen=True)
class WireBlock:
    path: Path
    start_line: int
    index: int
    text: str


def rel(path: Path) -> str:
    return path.relative_to(ROOT).as_posix()


def is_adr_doc(path: Path) -> bool:
    try:
        path.relative_to(DOCS / "ADRs")
    except ValueError:
        return False
    return True


def docs_markdown_files(*, include_adrs: bool) -> list[Path]:
    return sorted(
        path
        for path in DOCS.rglob("*.md")
        if path.is_file() and (include_adrs or not is_adr_doc(path))
    )


def extract_wire_blocks(path: Path) -> tuple[list[WireBlock], list[str]]:
    lines = path.read_text(encoding="utf-8").splitlines()
    blocks: list[WireBlock] = []
    errors: list[str] = []
    in_wire_block = False
    block_start = 0
    block_index = 0
    block_lines: list[str] = []

    for line_number, line in enumerate(lines, start=1):
        fence_match = FENCE_RE.match(line)
        if fence_match:
            if in_wire_block:
                blocks.append(
                    WireBlock(
                        path=path,
                        start_line=block_start,
                        index=block_index,
                        text="\n".join(block_lines) + "\n",
                    )
                )
                in_wire_block = False
                block_lines = []
                continue

            info = fence_match.group(1) or ""
            if info == "wire":
                block_index += 1
                in_wire_block = True
                block_start = line_number + 1
                block_lines = []
            continue

        if in_wire_block:
            block_lines.append(line)

    if in_wire_block:
        errors.append(f"{rel(path)}:{block_start - 1}: unterminated wire code fence")

    return blocks, errors


def diagnostic_lines(output: str, limit: int = 12) -> list[str]:
    return output.splitlines()[:limit]


def run_tree_sitter(command: list[str]) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        command,
        cwd=ROOT,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
    )


def build_parser_lib(tmp_dir: Path, grammar_dir: Path) -> tuple[Path | None, list[str]]:
    parser_lib = tmp_dir / "wire.so"
    result = run_tree_sitter(
        [
            "tree-sitter",
            "build",
            "-o",
            str(parser_lib),
            str(grammar_dir),
        ]
    )
    if result.returncode == 0:
        return parser_lib, []

    output = result.stdout + result.stderr
    lines = ["failed to build tree-sitter Wire parser"]
    lines.extend(f"  {line}" for line in diagnostic_lines(output))
    return None, lines


def parse_command(block_file: Path, parser_lib: Path | None, grammar_dir: Path) -> list[str]:
    if parser_lib is not None:
        return [
            "tree-sitter",
            "parse",
            "-q",
            "--lib-path",
            str(parser_lib),
            "--lang-name",
            "wire",
            str(block_file),
        ]

    return [
        "tree-sitter",
        "parse",
        "-q",
        "--scope",
        "source.wire",
        "-p",
        str(grammar_dir),
        str(block_file),
    ]


def parse_paths_command(paths_file: Path, parser_lib: Path, quiet: bool) -> list[str]:
    command = [
        "tree-sitter",
        "parse",
        "--paths",
        str(paths_file),
        "--lib-path",
        str(parser_lib),
        "--lang-name",
        "wire",
    ]
    if quiet:
        command.insert(2, "-q")
    return command


def parse_diagnostic_command(
    block_file: Path,
    parser_lib: Path | None,
    grammar_dir: Path,
) -> list[str]:
    command = parse_command(block_file, parser_lib, grammar_dir)
    return [part for part in command if part != "-q"]


def highlight_paths_command(paths_file: Path, grammar_dir: Path, quiet: bool) -> list[str]:
    command = [
        "tree-sitter",
        "highlight",
        "--check",
        "--scope",
        "source.wire",
        "-p",
        str(grammar_dir),
        "--paths",
        str(paths_file),
    ]
    if quiet:
        command.insert(2, "-q")
    return command


def write_block_files(blocks: list[WireBlock], tmp_dir: Path) -> list[tuple[WireBlock, Path]]:
    block_files: list[tuple[WireBlock, Path]] = []
    for block in blocks:
        block_file = tmp_dir / f"{block.path.stem}-{block.index}.wire"
        block_file.write_text(block.text, encoding="utf-8")
        block_files.append((block, block_file))
    return block_files


def validate_block_diagnostic(
    block: WireBlock,
    block_file: Path,
    parser_lib: Path | None,
    grammar_dir: Path,
) -> list[str]:
    location = f"{rel(block.path)}:{block.start_line}: wire block #{block.index}"
    parse_result = run_tree_sitter(parse_command(block_file, parser_lib, grammar_dir))
    if parse_result.returncode == 0:
        return []

    detail = run_tree_sitter(parse_diagnostic_command(block_file, parser_lib, grammar_dir))
    output = detail.stdout + detail.stderr
    lines = [f"{location}: failed tree-sitter parse"]
    lines.extend(f"  {line}" for line in diagnostic_lines(output))
    return lines


def validate_highlight_diagnostic(
    block: WireBlock,
    block_file: Path,
    grammar_dir: Path,
) -> list[str]:
    location = f"{rel(block.path)}:{block.start_line}: wire block #{block.index}"
    highlight_result = run_tree_sitter(
        [
            "tree-sitter",
            "highlight",
            "--check",
            "--scope",
            "source.wire",
            "-p",
            str(grammar_dir),
            str(block_file),
        ]
    )
    if highlight_result.returncode == 0:
        return []

    output = highlight_result.stdout + highlight_result.stderr
    lines = [f"{location}: failed tree-sitter highlight"]
    lines.extend(f"  {line}" for line in diagnostic_lines(output))
    return lines


def validate_blocks(
    blocks: list[WireBlock],
    tmp_dir: Path,
    parser_lib: Path | None,
    grammar_dir: Path,
    check_highlight: bool,
) -> list[str]:
    if not blocks:
        return []

    errors: list[str] = []
    block_files = write_block_files(blocks, tmp_dir)
    paths_file = tmp_dir / "wire-block-paths.txt"
    paths_file.write_text(
        "".join(f"{block_file}\n" for _, block_file in block_files),
        encoding="utf-8",
    )

    parse_lib = parser_lib
    if parse_lib is None:
        parse_lib, build_errors = build_parser_lib(tmp_dir, grammar_dir)
        if build_errors:
            return build_errors
        assert parse_lib is not None

    parse_result = run_tree_sitter(parse_paths_command(paths_file, parse_lib, quiet=True))
    if parse_result.returncode != 0:
        for block, block_file in block_files:
            errors.extend(validate_block_diagnostic(block, block_file, parse_lib, grammar_dir))

    if check_highlight:
        highlight_result = run_tree_sitter(
            highlight_paths_command(paths_file, grammar_dir, quiet=True)
        )
        if highlight_result.returncode != 0:
            for block, block_file in block_files:
                errors.extend(validate_highlight_diagnostic(block, block_file, grammar_dir))

    return errors


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--parser-lib",
        type=Path,
        help="Prebuilt tree-sitter parser library to use for parse validation.",
    )
    parser.add_argument(
        "--grammar-dir",
        type=Path,
        default=GRAMMAR_DIR,
        help="Tree-sitter grammar directory used for local parse/highlight validation.",
    )
    parser.add_argument(
        "--skip-highlight",
        action="store_true",
        help="Only parse examples; useful for hermetic checks that use --parser-lib.",
    )
    parser.add_argument(
        "--include-adrs",
        action="store_true",
        help="Also validate docs/ADRs historical decision records.",
    )
    args = parser.parse_args()
    check_highlight = not args.skip_highlight

    blocks: list[WireBlock] = []
    errors: list[str] = []
    for path in docs_markdown_files(include_adrs=args.include_adrs):
        path_blocks, path_errors = extract_wire_blocks(path)
        blocks.extend(path_blocks)
        errors.extend(path_errors)

    with tempfile.TemporaryDirectory(prefix="doc-wire-") as tmp:
        tmp_dir = Path(tmp)
        errors.extend(
            validate_blocks(
                blocks,
                tmp_dir,
                parser_lib=args.parser_lib,
                grammar_dir=args.grammar_dir,
                check_highlight=check_highlight,
            )
        )

    if errors:
        print("Docs Wire example failures:", file=sys.stderr)
        for error in errors:
            print(f"  {error}", file=sys.stderr)
        return 1

    print(f"checked {len(blocks)} docs Wire example(s)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

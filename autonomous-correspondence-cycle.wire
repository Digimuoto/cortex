# Autonomous Cortex correspondence cycle sketch.
#
# This is intentionally aspirational Wire. It sketches the "blessed" part of
# the PR #189 workflow as a durable graph: gather context, attack claims,
# classify gaps, implement one bounded slice, validate, publish, journal, and
# either stop or rewrite the graph for the next bounded iteration.
#
# It assumes a future Logos/Cortex executor library with repo, git, GitHub,
# Lean, Haskell, doc, journal, and graph-rewrite tools. The shape is the point;
# this file is not expected to compile with the current std library.

use logos.repo.{
  @snapshot,
  @diff_scope,
  @read_journal,
  @write_journal,
  @issue_index
};

use logos.review.{
  @theorem_attack,
  @lean_style_review,
  @haskell_style_review,
  @docs_scope_review,
  @archetype_passes
};

use logos.work.{
  @apply_slice,
  @run_matrix,
  @commit_signed,
  @push_branch,
  @pr_checks,
  @repair
};

use logos.wire.{@propose_rewrite, @apply_rewrite};

contract RunRequest;
contract RunCharter;
contract RepoSnapshot;
contract DiffScope;
contract JournalMemory;
contract IssueStack;
contract CorrespondenceMap;
contract ReviewBundle;
contract FindingSet;
contract Triage;
contract SlicePlan;
contract PatchSet;
contract ValidationPlan;
contract ValidationReport;
contract PublishRecord;
contract CiSnapshot;
contract JournalEntry;
contract RewriteProposal;
contract FinalReport;

node intake
  -> request: RunRequest = request;
  where let
    request = {
      branch = "174-wire-admission-witness-artifacts";
      pr = 189;
      journal = ".agent-journal/wire-admission-witness-artifacts.md";
      objective = "Advance Haskell-to-Lean Wire admission correspondence without widening scope.";
      hardStops = [
        "no P1/P2 theorem-attack findings",
        "validator-ready contract mirrored in Haskell and Lean",
        "compiler metadata emission gated by executable validator",
        "tests cover primitive/generated/phantom/select artifact families",
        "docs state remaining witness-production boundary",
        "two consecutive optional-accessor-only slices"
      ];
      forbidden = [
        "invent runtime correctness claims not carried by theorem statements",
        "add proof accessors without a downstream obligation",
        "publish with failing local gates",
        "rewrite shared history without explicit squash/ship phase"
      ];
    };
  in
  { inherit request; };

node charter
  <- request: RunRequest
  -> charter: RunCharter = charter;
  where let
    coreDone = [
      "artifact emitted",
      "artifact decoded",
      "artifact executable-validator-ready",
      "Lean mirror exists",
      "Lean ValidatorReady mirror exists",
      "source docs ledger synced"
    ];
    nextWorkRule = [
      "prefer executable bug or forged-artifact rejection",
      "then required Lean bridge for a named witness obligation",
      "then docs if prose overclaims",
      "stop before optional ergonomics churn"
    ];
    charter = {
      inherit request coreDone nextWorkRule;
      commitPolicy = {
        signed = true;
        provenanceRange = "origin/main..HEAD";
      };
      validationPolicy = {
        haskell = ["just test", "just lint", "just fmt-check"];
        lean = ["just lean-lint", "just lean-check"];
        docs = ["just docs-lint"];
        universal = ["git diff --check"];
      };
    };
  in
  { inherit charter; };

node repo_snapshot
  <- charter: RunCharter
  -> snapshot: RepoSnapshot
= @snapshot {
  payload = charter;
  cfg = {
    includeStatus = true;
    includeBranch = true;
    includeHead = true;
    preserveDirtyFiles = true;
  };
};

node diff_scope
  <- snapshot: RepoSnapshot
  -> scope: DiffScope
= @diff_scope {
  payload = snapshot;
  cfg = {
    base = "origin/main";
    include = [
      "src/Cortex/Wire/**/*.hs",
      "test/Cortex/Wire/**/*.hs",
      "theory/Cortex/Wire/**/*.lean",
      "theory/README.md",
      "docs/ADRs/**/*.md",
      "docs/Reference/**/*.md",
      "examples/wire/**/*.wire"
    ];
  };
};

node journal_memory
  <- charter: RunCharter
  -> memory: JournalMemory
= @read_journal {
  payload = charter;
  cfg = {
    primary = ".agent-journal/wire-admission-witness-artifacts.md";
    fallback = ".codex-journal/wire-compiler-finish-line.md";
    summarize = true;
    preserveTimestamps = true;
  };
};

node issue_stack
  <- charter: RunCharter
  -> issues: IssueStack
= @issue_index {
  payload = charter;
  cfg = {
    pr = 189;
    labels = ["wire", "lean", "compiler", "proof"];
    includeOpenReviewThreads = true;
    includeCiState = true;
  };
};

node correspondence_map
  <- scope: DiffScope
  <- memory: JournalMemory
  <- issues: IssueStack
  -> map: CorrespondenceMap = map;
  where let
    surfaces = [
      {
        name = "primitive replay";
        haskell = "wireAdmissionPrimitiveTraceStackValid";
        lean = "WireAdmissionArtifact.PrimitiveTraceStackValid";
        required = true;
      },
      {
        name = "generated forms";
        haskell = "wireAdmissionGeneratedChildFrontiersMatchPrimitive";
        lean = "GeneratedChildFrontiersMatchPrimitive";
        required = true;
      },
      {
        name = "phantom adapters";
        haskell = "wireAdmissionPhantomBridgeBulkConnectionsReplayed";
        lean = "PhantomBridgeBulkConnectionsReplayed";
        required = true;
      },
      {
        name = "select admission";
        haskell = "wireAdmissionSelectArmBodyBoundariesMatchCondition";
        lean = "SelectArmBodyBoundariesMatchCondition";
        required = true;
      },
      {
        name = "runtime proof production";
        haskell = null;
        lean = "ValidatorReady";
        required = false;
        status = "future proof-producing validator";
      }
    ];
    map = {
      inherit scope memory issues surfaces;
      missingRequired = surfaces |> filter (surface: surface.required && surface.status == "missing");
      optionalSurfaces = surfaces |> filter (surface: !surface.required);
    };
  in
  { inherit map; };

node theorem_attack
  <- map: CorrespondenceMap
  -> review: ReviewBundle
= @theorem_attack {
  payload = map;
  cfg = {
    mode = "sequential";
    lenses = ["logos", "episteme", "kritikos", "themis", "techne", "poiesis", "sophia"];
    rejectVacuousComposition = true;
    requireRuntimeCounterpart = true;
    priorityFocus = ["P1", "P2"];
  };
};

node lean_style
  <- map: CorrespondenceMap
  -> review: ReviewBundle
= @lean_style_review {
  payload = map;
  cfg = {
    checkTrustedBase = true;
    checkDocstrings = true;
    checkAccessorChurn = true;
    commands = ["just lean-lint"];
  };
};

node haskell_style
  <- map: CorrespondenceMap
  -> review: ReviewBundle
= @haskell_style_review {
  payload = map;
  cfg = {
    checkArtifactTruth = true;
    checkOwnedAdtWildcards = true;
    checkPublicJsonBoundaryTests = true;
    checkStringlyFields = true;
  };
};

node docs_review
  <- map: CorrespondenceMap
  -> review: ReviewBundle
= @docs_scope_review {
  payload = map;
  cfg = {
    checkProofClaims = true;
    checkAdrLedger = true;
    checkOutOfScopeBoundary = true;
  };
};

node synthesize_findings
  <- theorem: ReviewBundle
  <- lean: ReviewBundle
  <- haskell: ReviewBundle
  <- docs: ReviewBundle
  -> findings: FindingSet = findings;
  where let
    allFindings = concat [theorem.findings, lean.findings, haskell.findings, docs.findings];
    blockers = allFindings |> filter (finding: finding.priority == "P1" || finding.priority == "P2");
    executableDrift = allFindings |> filter (finding: finding.findingKind == "haskell-lean-drift");
    proofShapeRisk = allFindings |> filter (finding: finding.findingKind == "vacuous-theorem" || finding.findingKind == "accessor-churn");
    docsOverclaim = allFindings |> filter (finding: finding.findingKind == "docs-overclaim");
    findings = {
      inherit allFindings blockers executableDrift proofShapeRisk docsOverclaim;
      hasBlockers = length blockers > 0;
    };
  in
  { inherit findings; };

node triage
  <- charter: RunCharter
  <- map: CorrespondenceMap
  <- findings: FindingSet
  -> implement: Triage | stop: Triage | rewrite: Triage = decision;
  where let
    mustFix = findings.blockers;
    executableFirst = findings.executableDrift;
    proofRequired = findings.proofShapeRisk |> filter (finding: finding.requiredByDownstreamProof);
    docOnly = findings.docsOverclaim;
    optionalOnly = length mustFix == 0 && length executableFirst == 0 && length proofRequired == 0;
    shouldStop = optionalOnly || length map.missingRequired == 0 && charter.request.objectiveSatisfied;
    selected =
      if length executableFirst > 0 then executableFirst
      else if length mustFix > 0 then mustFix
      else if length proofRequired > 0 then proofRequired
      else docOnly;
    decision =
      if shouldStop then { stop = { reason = "core correspondence boundary met"; selected = []; }; }
      else if length selected > 0 then { implement = { inherit selected; maxFiles = 6; maxCommits = 2; }; }
      else { rewrite = { reason = "no bounded slice found; request a narrower graph"; }; };
  in
  decision;

node plan_slice
  <- implement: Triage
  -> plan: SlicePlan = plan;
  where let
    selected = implement.selected;
    hasHaskell = selected |> any (finding: finding.surface == "haskell" || finding.findingKind == "haskell-lean-drift");
    hasLean = selected |> any (finding: finding.surface == "lean" || finding.findingKind == "vacuous-theorem");
    hasDocs = selected |> any (finding: finding.findingKind == "docs-overclaim");
    commands = concat [
      if hasHaskell then ["just test", "just lint"] else [],
      if hasLean then ["just lean-lint", "just lean-check"] else [],
      if hasDocs then ["just docs-lint"] else [],
      ["just fmt-check", "git diff --check"]
    ];
    plan = {
      title = selected |> map (finding: finding.title) |> joinWith "; ";
      edits = selected |> map (finding: finding.repair);
      inherit commands;
      commitSubject = selected |> first |> (finding: finding.commitSubject);
      stopIf = [
        "requires new architecture decision",
        "third consecutive optional accessor",
        "validation failure not explained by edited files",
        "work exceeds maxFiles or maxCommits"
      ];
    };
  in
  { inherit plan; };

node apply_slice
  <- plan: SlicePlan
  -> patch: PatchSet
= @apply_slice {
  payload = plan;
  cfg = {
    useApplyPatch = true;
    preserveUserChanges = true;
    avoidUnrelatedRefactors = true;
    updateDocsWithScopeChange = true;
  };
};

node validation_plan
  <- plan: SlicePlan
  <- patch: PatchSet
  -> validation: ValidationPlan = validation;
  where let
    files = patch.files;
    leanFiles = files |> filter (file: endsWith file ".lean");
    haskellFiles = files |> filter (file: endsWith file ".hs");
    docsFiles = files |> filter (file: endsWith file ".md");
    commands = concat [
      if length leanFiles > 0 then ["just lean-lint", "just lean-check"] else [],
      if length haskellFiles > 0 then ["just test", "just lint"] else [],
      if length docsFiles > 0 then ["just docs-lint"] else [],
      ["just fmt-check", "git diff --check"]
    ];
    validation = {
      inherit files leanFiles haskellFiles docsFiles commands;
      fullEnough = length commands > 2;
    };
  in
  { inherit validation; };

node validate
  <- validation: ValidationPlan
  -> passed: ValidationReport | failed: ValidationReport
= @run_matrix {
  payload = validation;
  cfg = {
    stopOnFirstFailure = true;
    captureLogs = true;
    classifyFailure = true;
  };
};

node repair_validation
  <- failed: ValidationReport
  -> patch: PatchSet
= @apply_slice {
  payload = failed;
  cfg = {
    mode = "validation-repair";
    preserveOriginalScope = true;
    rejectScopeExpansion = true;
  };
};

node publish
  <- passed: ValidationReport
  -> published: PublishRecord
= @commit_signed {
  payload = passed;
  cfg = {
    sign = true;
    signoff = true;
    verifyCommit = true;
    provenance = "origin/main..HEAD";
    subjectFromPlan = true;
  };
};

node push
  <- published: PublishRecord
  -> published: PublishRecord
= @push_branch {
  payload = published;
  cfg = {
    branch = "174-wire-admission-witness-artifacts";
    forceWithLeaseOnlyIfRewritten = true;
  };
};

node ci_snapshot
  <- published: PublishRecord
  -> ci: CiSnapshot
= @pr_checks {
  payload = published;
  cfg = {
    pr = 189;
    unsetTokens = true;
    wait = "short";
  };
};

node ci_gate
  <- ci: CiSnapshot
  -> ok: CiSnapshot | repair: CiSnapshot | pending: CiSnapshot = decision;
  where let
    failing = ci.checks |> filter (check: check.conclusion == "failure");
    pending = ci.checks |> filter (check: check.status == "pending" || check.status == "queued");
    decision =
      if length failing > 0 then { repair = ci; }
      else if length pending > 0 then { pending = ci; }
      else { ok = ci; };
  in
  decision;

node repair_ci
  <- repair: CiSnapshot
  -> patch: PatchSet
= @repair {
  payload = repair;
  cfg = {
    preserveScope = true;
    reproduceLocallyFirst = true;
  };
};

node journal_slice
  <- charter: RunCharter
  <- map: CorrespondenceMap
  <- findings: FindingSet
  <- published: PublishRecord
  <- ci: CiSnapshot
  -> entry: JournalEntry
= @write_journal {
  payload = { inherit charter; inherit map; inherit findings; inherit published; inherit ci; };
  cfg = {
    path = ".agent-journal/wire-admission-witness-artifacts.md";
    include = [
      "timestamp",
      "input signal",
      "files changed",
      "theorem/test/doc names",
      "validation commands",
      "commit hash",
      "ci state",
      "next target",
      "stop rationale if optional-only"
    ];
  };
};

node propose_next_cycle
  <- charter: RunCharter
  <- findings: FindingSet
  <- ci: CiSnapshot
  <- entry: JournalEntry
  -> done: FinalReport | rewrite: RewriteProposal = decision;
  where let
    blockingFindings = findings.blockers;
    ciGreen = ci.state == "green";
    optionalOnly = length blockingFindings == 0 && findings.optionalOnly;
    shouldStop = optionalOnly && ciGreen;
    decision =
      if shouldStop then {
        done = {
          result = "stop";
          reason = "core correspondence boundary is met; remaining work is follow-up proof ergonomics";
          journalEntry = entry;
        };
      } else {
        rewrite = {
          title = "append bounded correspondence iteration";
          authority = "charter";
          budget = { nodes = 18; edges = 48; depth = 8; frontier = 16; ops = 6; };
          instruction = "Append one bounded iteration targeting the highest-priority unclosed Haskell/Lean correspondence gap. Do not add optional accessors unless tied to a named witness obligation.";
          seed = {
            findings = blockingFindings;
            inherit ci;
            journalEntry = entry;
          };
        };
      };
  in
  decision;

node apply_cycle_rewrite
  <- rewrite: RewriteProposal
  -> request: RunRequest
= @apply_rewrite {
  payload = rewrite;
  cfg = {
    requireBudget = true;
    requireFrontierPreservation = true;
    preserveJournalInput = true;
    preserveStopConditions = true;
  };
};

node final_report
  <- stop: Triage
  -> done: FinalReport = done;
  where let
    done = {
      result = "stop";
      reason = stop.reason;
      remaining = stop.selected;
    };
  in
  { inherit done; };

node workflow_metadata
  <- done: FinalReport
  -> done: FinalReport
= @cortex.workflow {
  payload = done;
  cfg = {
    workflowId = "wire_correspondence_autonomous_cycle";
    displayLabel = "Wire Correspondence Autonomous Cycle";
    displayDescription = "A bounded autonomous loop for advancing Haskell-to-Lean Wire admission correspondence while preventing optional proof-surface churn.";
    selectable = false;
    stageGraph = [
      "intake",
      "context",
      "review_lenses",
      "triage",
      "implementation",
      "validation",
      "publish",
      "journal",
      "rewrite_or_stop"
    ];
    stageModelPolicy = {
      theorem_attack = "frontier-reasoning";
      implementation = "coding";
      publish = "deterministic";
    };
    features = {
      adaptationPoints = {
        propose_next_cycle = {
          maxBranches = 1;
          propagateRewriteAuthority = true;
          promptSchema = {
            type = "string";
            description = "Return either an empty string to stop or a bounded Wire append proposal that targets one required Haskell/Lean correspondence gap.";
          };
          budgetSlice = {
            nodes = 18;
            edges = 48;
            depth = 8;
            frontier = 16;
            ops = 6;
          };
        };
      };
      stopPolicy = {
        hardStopAfterOptionalAccessorOnlySlices = 2;
        requireHumanReviewBeforeSquash = true;
        requireNoP1P2BeforeShip = true;
      };
    };
  };
};

export let context =
  intake
    => charter
    => (repo_snapshot <> journal_memory <> issue_stack)
    => diff_scope
    => correspondence_map;

export let review_lenses =
  (theorem_attack <> lean_style <> haskell_style <> docs_review)
    => synthesize_findings;

export let implementation_cycle =
  triage select(
    stop: final_report,
    implement:
      plan_slice
        => apply_slice
	        => validation_plan
	        => validate select(
	          failed:
	            repair_validation
	              => validation_plan
	              => validate,
	          passed:
	            publish
	              => push
	              => ci_snapshot
	              => ci_gate select(
	                repair:
	                  repair_ci
	                    => validation_plan
	                    => validate,
	                pending:
	                  journal_slice
	                    => propose_next_cycle,
	                ok:
	                  journal_slice
	                    => propose_next_cycle
	              )
	        ),
	    rewrite: apply_cycle_rewrite
  );

export let wire_correspondence_autonomous_cycle =
  context
	    => review_lenses
	    => implementation_cycle select(
	      done: workflow_metadata,
	      rewrite:
	        apply_cycle_rewrite
	          => charter
	    );

wire_correspondence_autonomous_cycle

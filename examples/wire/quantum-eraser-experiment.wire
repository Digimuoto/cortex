# which_path_phase_0: from examples/wire/quantum-eraser-which-path-phase-0.wire
node which0_ibm_runtime_config
  -> config: IBMQuantumConfig = @quantum.ibm_runtime_config { path = "quantum-ibm-runtime.local.json"; } (null);
node which0_prepare_screen
  <- config: IBMQuantumConfig;
  -> control: Qubit = @quantum.prepare_zero { index = 0; } ({ inherit config; });
node which0_prepare_marker
  -> target: Qubit = @quantum.prepare_zero { index = 1; } (null);
node which0_split_rz_a = qubit_gate(control, quantum_rz_quarter_turn);
node which0_split_sx = qubit_gate(control, quantum_sx);
node which0_split_rz_b = qubit_gate(control, quantum_rz_quarter_turn);
node which0_phase_screen = qubit_gate(control, quantum_rz_zero);
node which0_mark_pre_rz_a = qubit_gate(target, quantum_rz_quarter_turn);
node which0_mark_pre_sx = qubit_gate(target, quantum_sx);
node which0_mark_pre_rz_b = qubit_gate(target, quantum_rz_quarter_turn);
node which0_mark_cz = two_qubit_gate(control, target, quantum_cz);
node which0_z_mark_post_rz_a = qubit_gate(target, quantum_rz_quarter_turn);
node which0_z_mark_post_sx = qubit_gate(target, quantum_sx);
node which0_z_mark_post_rz_b = qubit_gate(target, quantum_rz_quarter_turn);
node which0_recombine_rz_a = qubit_gate(control, quantum_rz_quarter_turn);
node which0_recombine_sx = qubit_gate(control, quantum_sx);
node which0_recombine_rz_b = qubit_gate(control, quantum_rz_quarter_turn);
node which0_measure_screen = qubit_measure(control, screen);
node which0_z_measure_marker = qubit_measure(target, marker);

let which0_split_path =
  which0_split_rz_a
    => which0_split_sx
    => which0_split_rz_b
    => which0_phase_screen;

let which0_mark_marker_pre =
  which0_mark_pre_rz_a
    => which0_mark_pre_sx
    => which0_mark_pre_rz_b;

let which0_mark_marker_post =
  which0_z_mark_post_rz_a
    => which0_z_mark_post_sx
    => which0_z_mark_post_rz_b;

let which0_recombine_screen =
  which0_recombine_rz_a
    => which0_recombine_sx
    => which0_recombine_rz_b
    => which0_measure_screen;

let which0_marker_which_path_readout =
  which0_z_measure_marker;

export let which_path_phase_0 =
  which0_ibm_runtime_config
    => (
      (
        which0_prepare_screen
          => which0_split_path
          => which0_mark_cz
          => which0_recombine_screen
      )
      <>
      (
        which0_prepare_marker
          => which0_mark_marker_pre
          => which0_mark_cz
          => which0_mark_marker_post
          => which0_marker_which_path_readout
      )
  );


# Full delayed-choice quantum eraser experiment scaffold over IBM Runtime REST.
#
# Run:
#
#   nix run .#wire-quantum-eraser -- --confirm-hardware
#
# The experiment graph is Wire. Each command leaf submits one checked-in Wire
# circuit file through the IBM Runtime REST bridge. The final analyzer is a
# pure Wire node that parses JSON stdout with fromJson.

use std.io.{@stdout, @command, @writeFile, CommandSpec, CommandResult};

contract ExperimentStart;
contract ExperimentReport;

node start_experiment
  -> start: ExperimentStart = pure ("start");

node plan_experiment
  <- start: ExperimentStart;
  -> open0Spec: CommandSpec = pure (open0Spec);
  -> open14Spec: CommandSpec = pure (open14Spec);
  -> open12Spec: CommandSpec = pure (open12Spec);
  -> which0Spec: CommandSpec = pure (which0Spec);
  -> which14Spec: CommandSpec = pure (which14Spec);
  -> which12Spec: CommandSpec = pure (which12Spec);
  -> eraser0Spec: CommandSpec = pure (eraser0Spec);
  -> eraser14Spec: CommandSpec = pure (eraser14Spec);
  -> eraser12Spec: CommandSpec = pure (eraser12Spec);
  where let
    shots = "100";
    open0Spec = {
      name = "open phase 0";
      target = "examples/wire/quantum-eraser-open-phase-0.wire";
      argv = ["wire-quantum-ibm-rest", "examples/wire/quantum-eraser-open-phase-0.wire", "--shots", shots, "--confirm-hardware", "--json"];
      cwd = ".";
      required = true;
      skip = false;
      echo = false;
    };
    open14Spec = {
      name = "open phase 1/4";
      target = "examples/wire/quantum-eraser-open-phase-1_4.wire";
      argv = ["wire-quantum-ibm-rest", "examples/wire/quantum-eraser-open-phase-1_4.wire", "--shots", shots, "--confirm-hardware", "--json"];
      cwd = ".";
      required = true;
      skip = false;
      echo = false;
    };
    open12Spec = {
      name = "open phase 1/2";
      target = "examples/wire/quantum-eraser-open-phase-1_2.wire";
      argv = ["wire-quantum-ibm-rest", "examples/wire/quantum-eraser-open-phase-1_2.wire", "--shots", shots, "--confirm-hardware", "--json"];
      cwd = ".";
      required = true;
      skip = false;
      echo = false;
    };
    which0Spec = {
      name = "which-path phase 0";
      target = "examples/wire/quantum-eraser-which-path-phase-0.wire";
      argv = ["wire-quantum-ibm-rest", "examples/wire/quantum-eraser-which-path-phase-0.wire", "--shots", shots, "--confirm-hardware", "--json"];
      cwd = ".";
      required = true;
      skip = false;
      echo = false;
    };
    which14Spec = {
      name = "which-path phase 1/4";
      target = "examples/wire/quantum-eraser-which-path-phase-1_4.wire";
      argv = ["wire-quantum-ibm-rest", "examples/wire/quantum-eraser-which-path-phase-1_4.wire", "--shots", shots, "--confirm-hardware", "--json"];
      cwd = ".";
      required = true;
      skip = false;
      echo = false;
    };
    which12Spec = {
      name = "which-path phase 1/2";
      target = "examples/wire/quantum-eraser-which-path-phase-1_2.wire";
      argv = ["wire-quantum-ibm-rest", "examples/wire/quantum-eraser-which-path-phase-1_2.wire", "--shots", shots, "--confirm-hardware", "--json"];
      cwd = ".";
      required = true;
      skip = false;
      echo = false;
    };
    eraser0Spec = {
      name = "eraser phase 0";
      target = "examples/wire/quantum-eraser-round.wire";
      argv = ["wire-quantum-ibm-rest", "examples/wire/quantum-eraser-round.wire", "--shots", shots, "--confirm-hardware", "--json"];
      cwd = ".";
      required = true;
      skip = false;
      echo = false;
    };
    eraser14Spec = {
      name = "eraser phase 1/4";
      target = "examples/wire/quantum-eraser-eraser-phase-1_4.wire";
      argv = ["wire-quantum-ibm-rest", "examples/wire/quantum-eraser-eraser-phase-1_4.wire", "--shots", shots, "--confirm-hardware", "--json"];
      cwd = ".";
      required = true;
      skip = false;
      echo = false;
    };
    eraser12Spec = {
      name = "eraser phase 1/2";
      target = "examples/wire/quantum-eraser-eraser-phase-1_2.wire";
      argv = ["wire-quantum-ibm-rest", "examples/wire/quantum-eraser-eraser-phase-1_2.wire", "--shots", shots, "--confirm-hardware", "--json"];
      cwd = ".";
      required = true;
      skip = false;
      echo = false;
    };
  in
  { inherit open0Spec open14Spec open12Spec which0Spec which14Spec which12Spec eraser0Spec eraser14Spec eraser12Spec; };

node run_open_0
  <- open0Spec: CommandSpec;
  -> open0: CommandResult = @command {} (open0Spec);

node gate_open_14
  <- open14Spec: CommandSpec;
  <- open0: CommandResult;
  -> open14Ready: CommandSpec = pure (open14Spec);

node run_open_14
  <- open14Ready: CommandSpec;
  -> open14: CommandResult = @command {} (open14Ready);

node gate_open_12
  <- open12Spec: CommandSpec;
  <- open14: CommandResult;
  -> open12Ready: CommandSpec = pure (open12Spec);

node run_open_12
  <- open12Ready: CommandSpec;
  -> open12: CommandResult = @command {} (open12Ready);

node gate_which_0
  <- which0Spec: CommandSpec;
  <- open12: CommandResult;
  -> which0Ready: CommandSpec = pure (which0Spec);

node run_which_0
  <- which0Ready: CommandSpec;
  -> which0: CommandResult = @command {} (which0Ready);

node gate_which_14
  <- which14Spec: CommandSpec;
  <- which0: CommandResult;
  -> which14Ready: CommandSpec = pure (which14Spec);

node run_which_14
  <- which14Ready: CommandSpec;
  -> which14: CommandResult = @command {} (which14Ready);

node gate_which_12
  <- which12Spec: CommandSpec;
  <- which14: CommandResult;
  -> which12Ready: CommandSpec = pure (which12Spec);

node run_which_12
  <- which12Ready: CommandSpec;
  -> which12: CommandResult = @command {} (which12Ready);

node gate_eraser_0
  <- eraser0Spec: CommandSpec;
  <- which12: CommandResult;
  -> eraser0Ready: CommandSpec = pure (eraser0Spec);

node run_eraser_0
  <- eraser0Ready: CommandSpec;
  -> eraser0: CommandResult = @command {} (eraser0Ready);

node gate_eraser_14
  <- eraser14Spec: CommandSpec;
  <- eraser0: CommandResult;
  -> eraser14Ready: CommandSpec = pure (eraser14Spec);

node run_eraser_14
  <- eraser14Ready: CommandSpec;
  -> eraser14: CommandResult = @command {} (eraser14Ready);

node gate_eraser_12
  <- eraser12Spec: CommandSpec;
  <- eraser14: CommandResult;
  -> eraser12Ready: CommandSpec = pure (eraser12Spec);

node run_eraser_12
  <- eraser12Ready: CommandSpec;
  -> eraser12: CommandResult = @command {} (eraser12Ready);

node summarize_experiment
  <- open0: CommandResult;
  <- open14: CommandResult;
  <- open12: CommandResult;
  <- which0: CommandResult;
  <- which14: CommandResult;
  <- which12: CommandResult;
  <- eraser0: CommandResult;
  <- eraser14: CommandResult;
  <- eraser12: CommandResult;
  -> summary: ExperimentReport = pure (summary);
  where let
    runs = [open0, open14, open12, which0, which14, which12, eraser0, eraser14, eraser12];
    failures = runs |> filter (run: !run.ok);
    statuses = runs |> map (run: "${run.name}=${run.status}") |> joinWith ", ";
    targets = runs |> map (run: run.target) |> joinWith "\n  ";
    empty = "";
    space = " ";
    noneText = "none";
    noStderr = "(empty)";
    failureDetails =
      failures
        |> map (run: ''
          ${run.name}
            exit: ${if run.exitCode == null then noneText else run.exitCode}
            target: ${run.target}
            argv: ${run.argv |> joinWith space}
            stderr: ${if run.stderr == empty then noStderr else run.stderr}

        '')
        |> joinWith "";
    success = length failures == 0;
    summary = if success then
      let
        open0Json = fromJson(open0.stdout);
        open14Json = fromJson(open14.stdout);
        open12Json = fromJson(open12.stdout);
        which0Json = fromJson(which0.stdout);
        which14Json = fromJson(which14.stdout);
        which12Json = fromJson(which12.stdout);
        eraser0Json = fromJson(eraser0.stdout);
        eraser14Json = fromJson(eraser14.stdout);
        eraser12Json = fromJson(eraser12.stdout);
        hasCounts =
          open0Json.complete_counts != null
          && open14Json.complete_counts != null
          && open12Json.complete_counts != null
          && which0Json.complete_counts != null
          && which14Json.complete_counts != null
          && which12Json.complete_counts != null
          && eraser0Json.complete_counts != null
          && eraser14Json.complete_counts != null
          && eraser12Json.complete_counts != null;
      in
      if hasCounts then
        let
          oneBitBlock = phase: expected: result:
            let
              counts = result.complete_counts;
              c0 = counts["0"];
              c1 = counts["1"];
              shots = result.shots;
              screenZero = "${c0} of ${shots}";
            in
            ''
              phase ${phase}
                screen zeroes: ${screenZero} (${expected})
                counts: 0:${c0}, 1:${c1}

            '';
          twoBitBlock = phase: expected: result:
            let
              counts = result.complete_counts;
              c00 = counts["00"];
              c01 = counts["01"];
              c10 = counts["10"];
              c11 = counts["11"];
              shots = result.shots;
              screenZero = "${c00 + c10} of ${shots}";
              marker0Total = c00 + c01;
              marker1Total = c10 + c11;
              marker0Zero = "${c00} of ${marker0Total}";
              marker1Zero = "${c10} of ${marker1Total}";
            in
            ''
              phase ${phase}
                screen zeroes: ${screenZero} (${expected})
                marker 0 slice: ${marker0Zero} screen zeroes
                marker 1 slice: ${marker1Zero} screen zeroes
                counts: 00:${c00}, 01:${c01}, 10:${c10}, 11:${c11}

            '';
          openRows = [
            oneBitBlock "0" "near all" open0Json,
            oneBitBlock "1/4" "near half" open14Json,
            oneBitBlock "1/2" "near none" open12Json
          ] |> joinWith "";
          whichRows = [
            twoBitBlock "0" "near half" which0Json,
            twoBitBlock "1/4" "near half" which14Json,
            twoBitBlock "1/2" "near half" which12Json
          ] |> joinWith "";
          eraserRows = [
            twoBitBlock "0" "near half" eraser0Json,
            twoBitBlock "1/4" "near half" eraser14Json,
            twoBitBlock "1/2" "near half" eraser12Json
          ] |> joinWith "";
        in
        ''
          Wire delayed-choice quantum eraser experiment
          =============================================

          Run
            execution: Wire graph + std.io.command
            backend: IBM Quantum Runtime REST hardware
            shots: 100 per circuit
            circuits: 9 checked-in Wire files
            report file: /tmp/wire-quantum-eraser-report.txt

          Files executed
            ${targets}

          What Wire did
            Wire planned the sweep, sequenced nine hardware command leaves,
            parsed each REST JSON result with fromJson, and rendered this
            analyzer report in a pure Wire node. No Qiskit simulator path is
            used for the experiment.

          Three circular polarizers frame
            open: no which-path polarization tag; the screen follows the phase fringe.
            which_path: opposite circular tags distinguish the alternatives; the unsorted screen marginal sits near half.
            eraser: the final analyzer projects the circular tags into a common basis. The unsorted screen still stays near half, while marker-conditioned slices recover complementary fringes.

          Results

          open
          ${openRows}which_path
          ${whichRows}eraser
          ${eraserRows}Run gate: complete
        ''
      else
        ''
          Wire delayed-choice quantum eraser experiment
          =============================================

          Run
            execution: Wire graph + std.io.command
            backend: IBM Quantum Runtime REST hardware
            shots: 100 per circuit
            circuits: 9 checked-in Wire files
            report file: /tmp/wire-quantum-eraser-report.txt

          Files executed
            ${targets}

          The IBM REST runner completed, but at least one result did not contain decoded counts.
          Re-run the failed circuit directly with --json and inspect raw_result.

          Results
            ${statuses}

          Run gate: result decoder needs attention
        ''
    else
      ''
        Wire delayed-choice quantum eraser experiment
        =============================================

        Run
          execution: Wire graph + std.io.command
          backend: IBM Quantum Runtime REST hardware
          shots: 100 per circuit
          circuits: 9 checked-in Wire files
          report file: /tmp/wire-quantum-eraser-report.txt

        Files executed
          ${targets}

        At least one hardware command failed before analysis, so the pure Wire analyzer did not parse stdout.

        Results
          ${statuses}

        Failed rows
        ${failureDetails}Run gate: failed
      '';
  in
  { inherit summary; };

node print_report
  <- summary: ExperimentReport;
  = @stdout { newline = true; } (summary);

node write_report
  <- summary: ExperimentReport;
  = @writeFile { path = "/tmp/wire-quantum-eraser-report.txt"; } (summary);

(
  start_experiment
    => plan_experiment
    => (
      run_open_0
      <> gate_open_14
      <> run_open_14
      <> gate_open_12
      <> run_open_12
      <> gate_which_0
      <> run_which_0
      <> gate_which_14
      <> run_which_14
      <> gate_which_12
      <> run_which_12
      <> gate_eraser_0
      <> run_eraser_0
      <> gate_eraser_14
      <> run_eraser_14
      <> gate_eraser_12
      <> run_eraser_12
    )
)
<>
(
  run_open_0
    => gate_open_14
    => run_open_14
    => gate_open_12
    => run_open_12
    => gate_which_0
    => run_which_0
    => gate_which_14
    => run_which_14
    => gate_which_12
    => run_which_12
    => gate_eraser_0
    => run_eraser_0
    => gate_eraser_14
    => run_eraser_14
    => gate_eraser_12
    => run_eraser_12
)
<>
(
  (
    run_open_0
    <> gate_open_14
    <> run_open_14
    <> gate_open_12
    <> run_open_12
    <> gate_which_0
    <> run_which_0
    <> gate_which_14
    <> run_which_14
    <> gate_which_12
    <> run_which_12
    <> gate_eraser_0
    <> run_eraser_0
    <> gate_eraser_14
    <> run_eraser_14
    <> gate_eraser_12
    <> run_eraser_12
  )
    => summarize_experiment
    => (print_report <> write_report)
)

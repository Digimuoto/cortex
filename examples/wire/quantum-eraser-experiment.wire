# Full delayed-choice quantum eraser experiment scaffold over IBM Runtime REST.
#
# Run:
#
#   nix run .#wire-quantum-eraser -- --confirm-hardware
#
# The experiment graph is Wire. Each command leaf selects one exported circuit
# graph value from this file and submits it through the IBM Runtime REST bridge.
# The final analyzer is a pure Wire node that parses JSON stdout with fromJson.

use std.io.{@stdout, @command, @writeFile, CommandSpec, CommandResult};

contract ExperimentStart;
contract ExperimentReport;
contract IBMQuantumConfig;
contract Qubit;
contract Bit;

let quantum_rz_zero = @quantum.rz { angle = 0.0; };
let quantum_rz_quarter_turn = @quantum.rz { angle = 1.5707963267948966; };
let quantum_rz_half_turn = @quantum.rz { angle = 3.141592653589793; };
let quantum_sx = @quantum.sx {};
let quantum_cz = @quantum.cz {};
let quantum_measure_z = @quantum.measure_z {};

kind qubit_gate(label: PortLabel, gate: ConfiguredExecutor) =
  <- label: Qubit;
  -> label: Qubit = gate (label);

kind qubit_measure(input: PortLabel, output: PortLabel) =
  <- input: Qubit;
  -> output: Bit = quantum_measure_z (input);

kind two_qubit_gate(control: PortLabel, target: PortLabel, gate: ConfiguredExecutor) =
  <- control: Qubit;
  <- target: Qubit;
  -> control: Qubit;
  -> target: Qubit;
  = gate ({ inherit control; inherit target; });

# Hardware circuit graph forms for the eraser sweep.
#
# Each exported graph is selected with `wire build --return NAME` by the
# IBM REST command leaves below. The default file-return at the bottom
# remains the experiment orchestration graph.

form open_circuit(phase_gate: ConfiguredExecutor) = {
  node ibm_runtime_config
    -> config: IBMQuantumConfig = @quantum.ibm_runtime_config { path = "quantum-ibm-runtime.local.json"; } (null);
  node prepare_screen
    <- config: IBMQuantumConfig;
    -> screen: Qubit = @quantum.prepare_zero { index = 0; } ({ inherit config; });
  node split_rz_a = qubit_gate(screen, quantum_rz_quarter_turn);
  node split_sx = qubit_gate(screen, quantum_sx);
  node split_rz_b = qubit_gate(screen, quantum_rz_quarter_turn);
  node phase_screen = qubit_gate(screen, phase_gate);
  node recombine_rz_a = qubit_gate(screen, quantum_rz_quarter_turn);
  node recombine_sx = qubit_gate(screen, quantum_sx);
  node recombine_rz_b = qubit_gate(screen, quantum_rz_quarter_turn);
  node measure_screen = qubit_measure(screen, screen);

  let split_path =
    split_rz_a
      => split_sx
      => split_rz_b;

  let recombine_path =
    phase_screen
      => recombine_rz_a
      => recombine_sx
      => recombine_rz_b
      => measure_screen;

  ibm_runtime_config
    => prepare_screen
    => split_path
    => recombine_path;
};

form which_path_circuit(phase_gate: ConfiguredExecutor) = {
  node ibm_runtime_config
    -> config: IBMQuantumConfig = @quantum.ibm_runtime_config { path = "quantum-ibm-runtime.local.json"; } (null);
  node prepare_screen
    <- config: IBMQuantumConfig;
    -> control: Qubit = @quantum.prepare_zero { index = 0; } ({ inherit config; });
  node prepare_marker
    -> target: Qubit = @quantum.prepare_zero { index = 1; } (null);
  node split_rz_a = qubit_gate(control, quantum_rz_quarter_turn);
  node split_sx = qubit_gate(control, quantum_sx);
  node split_rz_b = qubit_gate(control, quantum_rz_quarter_turn);
  node phase_screen = qubit_gate(control, phase_gate);
  node mark_pre_rz_a = qubit_gate(target, quantum_rz_quarter_turn);
  node mark_pre_sx = qubit_gate(target, quantum_sx);
  node mark_pre_rz_b = qubit_gate(target, quantum_rz_quarter_turn);
  node mark_cz = two_qubit_gate(control, target, quantum_cz);
  node z_mark_post_rz_a = qubit_gate(target, quantum_rz_quarter_turn);
  node z_mark_post_sx = qubit_gate(target, quantum_sx);
  node z_mark_post_rz_b = qubit_gate(target, quantum_rz_quarter_turn);
  node recombine_rz_a = qubit_gate(control, quantum_rz_quarter_turn);
  node recombine_sx = qubit_gate(control, quantum_sx);
  node recombine_rz_b = qubit_gate(control, quantum_rz_quarter_turn);
  node measure_screen = qubit_measure(control, screen);
  node z_measure_marker = qubit_measure(target, marker);

  let split_path =
    split_rz_a
      => split_sx
      => split_rz_b
      => phase_screen;

  let mark_marker_pre =
    mark_pre_rz_a
      => mark_pre_sx
      => mark_pre_rz_b;

  let mark_marker_post =
    z_mark_post_rz_a
      => z_mark_post_sx
      => z_mark_post_rz_b;

  let recombine_screen =
    recombine_rz_a
      => recombine_sx
      => recombine_rz_b
      => measure_screen;

  let marker_which_path_readout =
    z_measure_marker;

  ibm_runtime_config
    => (
      (
        prepare_screen
          => split_path
          => mark_cz
          => recombine_screen
      )
      <>
      (
        prepare_marker
          => mark_marker_pre
          => mark_cz
          => mark_marker_post
          => marker_which_path_readout
      )
  );
};

form eraser_circuit(phase_gate: ConfiguredExecutor) = {
  node ibm_runtime_config
    -> config: IBMQuantumConfig = @quantum.ibm_runtime_config { path = "quantum-ibm-runtime.local.json"; } (null);
  node prepare_screen
    <- config: IBMQuantumConfig;
    -> control: Qubit = @quantum.prepare_zero { index = 0; } ({ inherit config; });
  node prepare_marker
    -> target: Qubit = @quantum.prepare_zero { index = 1; } (null);
  node split_rz_a = qubit_gate(control, quantum_rz_quarter_turn);
  node split_sx = qubit_gate(control, quantum_sx);
  node split_rz_b = qubit_gate(control, quantum_rz_quarter_turn);
  node phase_screen = qubit_gate(control, phase_gate);
  node mark_pre_rz_a = qubit_gate(target, quantum_rz_quarter_turn);
  node mark_pre_sx = qubit_gate(target, quantum_sx);
  node mark_pre_rz_b = qubit_gate(target, quantum_rz_quarter_turn);
  node mark_cz = two_qubit_gate(control, target, quantum_cz);
  node z_mark_post_rz_a = qubit_gate(target, quantum_rz_quarter_turn);
  node z_mark_post_sx = qubit_gate(target, quantum_sx);
  node z_mark_post_rz_b = qubit_gate(target, quantum_rz_quarter_turn);
  node recombine_rz_a = qubit_gate(control, quantum_rz_quarter_turn);
  node recombine_sx = qubit_gate(control, quantum_sx);
  node recombine_rz_b = qubit_gate(control, quantum_rz_quarter_turn);
  node measure_screen = qubit_measure(control, screen);
  node z_marker_eraser_rz_a = qubit_gate(target, quantum_rz_quarter_turn);
  node z_marker_eraser_sx = qubit_gate(target, quantum_sx);
  node z_marker_eraser_rz_b = qubit_gate(target, quantum_rz_quarter_turn);
  node z_measure_marker = qubit_measure(target, marker);

  let split_path =
    split_rz_a
      => split_sx
      => split_rz_b
      => phase_screen;

  let mark_marker_pre =
    mark_pre_rz_a
      => mark_pre_sx
      => mark_pre_rz_b;

  let mark_marker_post =
    z_mark_post_rz_a
      => z_mark_post_sx
      => z_mark_post_rz_b;

  let recombine_screen =
    recombine_rz_a
      => recombine_sx
      => recombine_rz_b
      => measure_screen;

  let marker_eraser_readout =
    z_marker_eraser_rz_a
      => z_marker_eraser_sx
      => z_marker_eraser_rz_b
      => z_measure_marker;

  ibm_runtime_config
    => (
      (
        prepare_screen
          => split_path
          => mark_cz
          => recombine_screen
      )
      <>
      (
        prepare_marker
          => mark_marker_pre
          => mark_cz
          => mark_marker_post
          => marker_eraser_readout
      )
  );
};

export let open_phase_0 = open_circuit(quantum_rz_zero);
export let open_phase_1_4 = open_circuit(quantum_rz_quarter_turn);
export let open_phase_1_2 = open_circuit(quantum_rz_half_turn);

export let which_path_phase_0 = which_path_circuit(quantum_rz_zero);
export let which_path_phase_1_4 = which_path_circuit(quantum_rz_quarter_turn);
export let which_path_phase_1_2 = which_path_circuit(quantum_rz_half_turn);

export let eraser_phase_0 = eraser_circuit(quantum_rz_zero);
export let eraser_phase_1_4 = eraser_circuit(quantum_rz_quarter_turn);
export let eraser_phase_1_2 = eraser_circuit(quantum_rz_half_turn);

node start_experiment
  -> start: ExperimentStart = pure ("start");

node plan_experiment
  <- start: ExperimentStart;
  -> open0Spec: CommandSpec = pure (open0Spec);
  -> open14Spec: CommandSpec = pure (open14Spec);
  -> open12Spec: CommandSpec = pure (open12Spec);
  -> which0Spec: CommandSpec = pure (which0Spec);
  -> which14Spec: CommandSpec = pure (which14Spec);
  -> which12Spec: CommandSpec = pure (which12Spec);
  -> eraser0Spec: CommandSpec = pure (eraser0Spec);
  -> eraser14Spec: CommandSpec = pure (eraser14Spec);
  -> eraser12Spec: CommandSpec = pure (eraser12Spec);
  where let
    shots = "100";
    source = "examples/wire/quantum-eraser-experiment.wire";
    open0Spec = {
      name = "open phase 0";
      target = "examples/wire/quantum-eraser-experiment.wire#open_phase_0";
      argv = ["wire-quantum-ibm-rest", source, "--return", "open_phase_0", "--shots", shots, "--confirm-hardware", "--json"];
      cwd = ".";
      required = true;
      skip = false;
      echo = false;
    };
    open14Spec = {
      name = "open phase 1/4";
      target = "examples/wire/quantum-eraser-experiment.wire#open_phase_1_4";
      argv = ["wire-quantum-ibm-rest", source, "--return", "open_phase_1_4", "--shots", shots, "--confirm-hardware", "--json"];
      cwd = ".";
      required = true;
      skip = false;
      echo = false;
    };
    open12Spec = {
      name = "open phase 1/2";
      target = "examples/wire/quantum-eraser-experiment.wire#open_phase_1_2";
      argv = ["wire-quantum-ibm-rest", source, "--return", "open_phase_1_2", "--shots", shots, "--confirm-hardware", "--json"];
      cwd = ".";
      required = true;
      skip = false;
      echo = false;
    };
    which0Spec = {
      name = "which-path phase 0";
      target = "examples/wire/quantum-eraser-experiment.wire#which_path_phase_0";
      argv = ["wire-quantum-ibm-rest", source, "--return", "which_path_phase_0", "--shots", shots, "--confirm-hardware", "--json"];
      cwd = ".";
      required = true;
      skip = false;
      echo = false;
    };
    which14Spec = {
      name = "which-path phase 1/4";
      target = "examples/wire/quantum-eraser-experiment.wire#which_path_phase_1_4";
      argv = ["wire-quantum-ibm-rest", source, "--return", "which_path_phase_1_4", "--shots", shots, "--confirm-hardware", "--json"];
      cwd = ".";
      required = true;
      skip = false;
      echo = false;
    };
    which12Spec = {
      name = "which-path phase 1/2";
      target = "examples/wire/quantum-eraser-experiment.wire#which_path_phase_1_2";
      argv = ["wire-quantum-ibm-rest", source, "--return", "which_path_phase_1_2", "--shots", shots, "--confirm-hardware", "--json"];
      cwd = ".";
      required = true;
      skip = false;
      echo = false;
    };
    eraser0Spec = {
      name = "eraser phase 0";
      target = "examples/wire/quantum-eraser-experiment.wire#eraser_phase_0";
      argv = ["wire-quantum-ibm-rest", source, "--return", "eraser_phase_0", "--shots", shots, "--confirm-hardware", "--json"];
      cwd = ".";
      required = true;
      skip = false;
      echo = false;
    };
    eraser14Spec = {
      name = "eraser phase 1/4";
      target = "examples/wire/quantum-eraser-experiment.wire#eraser_phase_1_4";
      argv = ["wire-quantum-ibm-rest", source, "--return", "eraser_phase_1_4", "--shots", shots, "--confirm-hardware", "--json"];
      cwd = ".";
      required = true;
      skip = false;
      echo = false;
    };
    eraser12Spec = {
      name = "eraser phase 1/2";
      target = "examples/wire/quantum-eraser-experiment.wire#eraser_phase_1_2";
      argv = ["wire-quantum-ibm-rest", source, "--return", "eraser_phase_1_2", "--shots", shots, "--confirm-hardware", "--json"];
      cwd = ".";
      required = true;
      skip = false;
      echo = false;
    };
  in
  { inherit open0Spec open14Spec open12Spec which0Spec which14Spec which12Spec eraser0Spec eraser14Spec eraser12Spec; };

node run_open_0
  <- open0Spec: CommandSpec;
  -> open0: CommandResult = @command {} (open0Spec);

node gate_open_14
  <- open14Spec: CommandSpec;
  <- open0: CommandResult;
  -> open14Ready: CommandSpec = pure (open14Spec);

node run_open_14
  <- open14Ready: CommandSpec;
  -> open14: CommandResult = @command {} (open14Ready);

node gate_open_12
  <- open12Spec: CommandSpec;
  <- open14: CommandResult;
  -> open12Ready: CommandSpec = pure (open12Spec);

node run_open_12
  <- open12Ready: CommandSpec;
  -> open12: CommandResult = @command {} (open12Ready);

node gate_which_0
  <- which0Spec: CommandSpec;
  <- open12: CommandResult;
  -> which0Ready: CommandSpec = pure (which0Spec);

node run_which_0
  <- which0Ready: CommandSpec;
  -> which0: CommandResult = @command {} (which0Ready);

node gate_which_14
  <- which14Spec: CommandSpec;
  <- which0: CommandResult;
  -> which14Ready: CommandSpec = pure (which14Spec);

node run_which_14
  <- which14Ready: CommandSpec;
  -> which14: CommandResult = @command {} (which14Ready);

node gate_which_12
  <- which12Spec: CommandSpec;
  <- which14: CommandResult;
  -> which12Ready: CommandSpec = pure (which12Spec);

node run_which_12
  <- which12Ready: CommandSpec;
  -> which12: CommandResult = @command {} (which12Ready);

node gate_eraser_0
  <- eraser0Spec: CommandSpec;
  <- which12: CommandResult;
  -> eraser0Ready: CommandSpec = pure (eraser0Spec);

node run_eraser_0
  <- eraser0Ready: CommandSpec;
  -> eraser0: CommandResult = @command {} (eraser0Ready);

node gate_eraser_14
  <- eraser14Spec: CommandSpec;
  <- eraser0: CommandResult;
  -> eraser14Ready: CommandSpec = pure (eraser14Spec);

node run_eraser_14
  <- eraser14Ready: CommandSpec;
  -> eraser14: CommandResult = @command {} (eraser14Ready);

node gate_eraser_12
  <- eraser12Spec: CommandSpec;
  <- eraser14: CommandResult;
  -> eraser12Ready: CommandSpec = pure (eraser12Spec);

node run_eraser_12
  <- eraser12Ready: CommandSpec;
  -> eraser12: CommandResult = @command {} (eraser12Ready);

node summarize_experiment
  <- open0: CommandResult;
  <- open14: CommandResult;
  <- open12: CommandResult;
  <- which0: CommandResult;
  <- which14: CommandResult;
  <- which12: CommandResult;
  <- eraser0: CommandResult;
  <- eraser14: CommandResult;
  <- eraser12: CommandResult;
  -> summary: ExperimentReport = pure (summary);
  where let
    runs = [open0, open14, open12, which0, which14, which12, eraser0, eraser14, eraser12];
    failures = runs |> filter (run: !run.ok);
    statuses = runs |> map (run: "${run.name}=${run.status}") |> joinWith ", ";
    targets = runs |> map (run: run.target) |> joinWith "\n  ";
    empty = "";
    space = " ";
    noneText = "none";
    noStderr = "(empty)";
    failureDetails =
      failures
        |> map (run: ''
          ${run.name}
            exit: ${if run.exitCode == null then noneText else run.exitCode}
            target: ${run.target}
            argv: ${run.argv |> joinWith space}
            stderr: ${if run.stderr == empty then noStderr else run.stderr}

        '')
        |> joinWith "";
    success = length failures == 0;
    summary = if success then
      let
        open0Json = fromJson(open0.stdout);
        open14Json = fromJson(open14.stdout);
        open12Json = fromJson(open12.stdout);
        which0Json = fromJson(which0.stdout);
        which14Json = fromJson(which14.stdout);
        which12Json = fromJson(which12.stdout);
        eraser0Json = fromJson(eraser0.stdout);
        eraser14Json = fromJson(eraser14.stdout);
        eraser12Json = fromJson(eraser12.stdout);
        hasCounts =
          open0Json.complete_counts != null
          && open14Json.complete_counts != null
          && open12Json.complete_counts != null
          && which0Json.complete_counts != null
          && which14Json.complete_counts != null
          && which12Json.complete_counts != null
          && eraser0Json.complete_counts != null
          && eraser14Json.complete_counts != null
          && eraser12Json.complete_counts != null;
      in
      if hasCounts then
        let
          oneBit = result:
            let
              counts = result.complete_counts;
              c0 = counts["0"];
              c1 = counts["1"];
              shots = result.shots;
            in
            { inherit c0 c1 shots; };
          twoBit = result:
            let
              counts = result.complete_counts;
              c00 = counts["00"];
              c01 = counts["01"];
              c10 = counts["10"];
              c11 = counts["11"];
              shots = result.shots;
              screenZero = c00 + c10;
              marker0Total = c00 + c01;
              marker1Total = c10 + c11;
            in
            { inherit c00 c01 c10 c11 shots screenZero marker0Total marker1Total; };
          oneRow = mode: phase: expected: bit:
            "  ${mode} | ${phase} | ${bit.c0}/${bit.shots} | ${expected} | - | - | 0:${bit.c0},1:${bit.c1}\n";
          twoRow = mode: phase: expected: bit:
            "  ${mode} | ${phase} | ${bit.screenZero}/${bit.shots} | ${expected} | ${bit.c00}/${bit.marker0Total} | ${bit.c10}/${bit.marker1Total} | 00:${bit.c00},01:${bit.c01},10:${bit.c10},11:${bit.c11}\n";
          open0Bits = oneBit(open0Json);
          open14Bits = oneBit(open14Json);
          open12Bits = oneBit(open12Json);
          which0Bits = twoBit(which0Json);
          which14Bits = twoBit(which14Json);
          which12Bits = twoBit(which12Json);
          eraser0Bits = twoBit(eraser0Json);
          eraser14Bits = twoBit(eraser14Json);
          eraser12Bits = twoBit(eraser12Json);
          resultRows = [
            "  mode | phase | screen=0 | expected screen | marker=0 screen=0 | marker=1 screen=0 | raw counts\n",
            "  ---- | ----- | -------- | --------------- | ----------------- | ----------------- | ----------\n",
            oneRow "open" "0" "bright" open0Bits,
            oneRow "open" "1/4" "balanced" open14Bits,
            oneRow "open" "1/2" "dark" open12Bits,
            twoRow "which_path" "0" "balanced" which0Bits,
            twoRow "which_path" "1/4" "balanced" which14Bits,
            twoRow "which_path" "1/2" "balanced" which12Bits,
            twoRow "eraser" "0" "balanced before sorting" eraser0Bits,
            twoRow "eraser" "1/4" "balanced before sorting" eraser14Bits,
            twoRow "eraser" "1/2" "balanced before sorting" eraser12Bits
          ] |> joinWith "";
          openReading = ''
            Open graph: no middle circular tag
              No path marker is inserted between the splitter and recombiner.
              In the circular-polarizer picture, this is the reference stack:
              the screen behaves like the final analyzer with no middle
              which-path filter left in the beam.

              Phase 0: screen=0 appeared ${open0Bits.c0}/${open0Bits.shots} times, the bright fringe.
              Phase 1/4: screen=0 appeared ${open14Bits.c0}/${open14Bits.shots} times, the halfway setting.
              Phase 1/2: screen=0 appeared ${open12Bits.c0}/${open12Bits.shots} times, the dark fringe.

              Those three numbers are the reference interference fringe.

          '';
          whichPathReading = ''
            Which-path graph: opposite circular tags left in place
              The marker is the middle polarizer. It tags the two alternatives
              as opposite circular polarizations, so the screen alone can no
              longer combine them into a phase fringe.

              Unsorted screen=0 counts:
                phase 0: ${which0Bits.screenZero}/${which0Bits.shots}
                phase 1/4: ${which14Bits.screenZero}/${which14Bits.shots}
                phase 1/2: ${which12Bits.screenZero}/${which12Bits.shots}

              Instead of following the open fringe ${open0Bits.c0}/${open0Bits.shots}
              -> ${open14Bits.c0}/${open14Bits.shots} -> ${open12Bits.c0}/${open12Bits.shots},
              all three which-path rows sit around half.

              Sorting by the readable marker still does not recover the clean
              fringe:
                phase 0 marker=0: ${which0Bits.c00}/${which0Bits.marker0Total}
                phase 0 marker=1: ${which0Bits.c10}/${which0Bits.marker1Total}
                phase 1/2 marker=0: ${which12Bits.c00}/${which12Bits.marker0Total}
                phase 1/2 marker=1: ${which12Bits.c10}/${which12Bits.marker1Total}

              The circular path labels are still present, so the alternatives
              remain distinguishable.

          '';
          eraserReading = ''
            Eraser graph: final analyzer erases the circular tag
              The eraser adds the third polarizer: a final marker analyzer that
              projects the left/right circular tags into a common basis.

              Before sorting by marker, the screen still respects no-signalling:
                phase 0 screen=0: ${eraser0Bits.screenZero}/${eraser0Bits.shots}
                phase 1/4 screen=0: ${eraser14Bits.screenZero}/${eraser14Bits.shots}
                phase 1/2 screen=0: ${eraser12Bits.screenZero}/${eraser12Bits.shots}

              Those unsorted numbers stay near half, so the later analyzer did
              not rewrite the earlier screen distribution.

              The interference returns only after conditioning on the marker.
                phase 0 marker=0: ${eraser0Bits.c00}/${eraser0Bits.marker0Total}
                phase 0 marker=1: ${eraser0Bits.c10}/${eraser0Bits.marker1Total}
                phase 1/2 marker=0: ${eraser12Bits.c00}/${eraser12Bits.marker0Total}
                phase 1/2 marker=1: ${eraser12Bits.c10}/${eraser12Bits.marker1Total}
                phase 1/4 marker=0: ${eraser14Bits.c00}/${eraser14Bits.marker0Total}
                phase 1/4 marker=1: ${eraser14Bits.c10}/${eraser14Bits.marker1Total}

              Phase 0 is bright in marker=0 and dark in marker=1. Phase 1/2
              trades those roles. Phase 1/4 crosses near the middle.

              That is the quantum eraser in the polarized-filter picture: the
              middle circular marker destroys the visible screen fringe, and
              the final analyzer recovers two opposite fringes only when the
              data is sorted by its marker result.

          '';
        in
        ''
          Wire delayed-choice quantum eraser experiment
          =============================================

          Run
            source: examples/wire/quantum-eraser-experiment.wire
            execution: one Wire orchestration graph + std.io.command leaves
            backend: IBM Quantum Runtime REST hardware
            shots: 100 per circuit
            circuits: 9 exported graph values selected from this same Wire file
            report file: ./wire-quantum-eraser-report.txt

          Circuit graph values submitted
            ${targets}

          What Wire did
            Wire planned the sweep, sequenced nine hardware command leaves,
            selected each circuit with wire build --return, parsed each REST
            JSON result with fromJson, and rendered this analyzer report in a
            pure Wire node. No Qiskit simulator path is used for the experiment.

          Results
          ${resultRows}

          Reading the numbers through three circular polarizers
          ${openReading}${whichPathReading}${eraserReading}Run gate: complete
        ''
      else
        ''
          Wire delayed-choice quantum eraser experiment
          =============================================

          Run
            source: examples/wire/quantum-eraser-experiment.wire
            execution: one Wire orchestration graph + std.io.command leaves
            backend: IBM Quantum Runtime REST hardware
            shots: 100 per circuit
            circuits: 9 exported graph values selected from this same Wire file
            report file: ./wire-quantum-eraser-report.txt

          Circuit graph values submitted
            ${targets}

          The IBM REST runner completed, but at least one result did not contain decoded counts.
          Re-run the failed circuit directly with --json and inspect raw_result.

          Results
            ${statuses}

          Run gate: result decoder needs attention
        ''
    else
      ''
        Wire delayed-choice quantum eraser experiment
        =============================================

        Run
          source: examples/wire/quantum-eraser-experiment.wire
          execution: one Wire orchestration graph + std.io.command leaves
          backend: IBM Quantum Runtime REST hardware
          shots: 100 per circuit
          circuits: 9 exported graph values selected from this same Wire file
          report file: ./wire-quantum-eraser-report.txt

        Circuit graph values submitted
          ${targets}

        At least one hardware command failed before analysis, so the pure Wire analyzer did not parse stdout.

        Results
          ${statuses}

        Failed rows
        ${failureDetails}Run gate: failed
      '';
  in
  { inherit summary; };

node print_report
  <- summary: ExperimentReport;
  = @stdout { newline = true; } (summary);

node write_report
  <- summary: ExperimentReport;
  = @writeFile { path = "./wire-quantum-eraser-report.txt"; } (summary);

(
  start_experiment

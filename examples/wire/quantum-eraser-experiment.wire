# Full delayed-choice quantum eraser experiment scaffold over IBM Runtime REST.
#
# Run:
#
#   nix run .#wire-quantum-eraser -- --confirm-hardware
#
# The experiment graph is Wire. Each command leaf submits one checked-in Wire
# circuit file through the IBM Runtime REST bridge. The final analyzer is a
# pure Wire node that parses JSON stdout with fromJson.

contract CommandSpec;
contract CommandResult;
contract ExperimentStart;
contract ExperimentReport;

node start_experiment
  -> start: ExperimentStart = pure ("start");

node plan_experiment
  <- start: ExperimentStart;
  -> open0Spec: CommandSpec = pure (open0Spec);
  -> open14Spec: CommandSpec = pure (open14Spec);
  -> open12Spec: CommandSpec = pure (open12Spec);
  -> which0Spec: CommandSpec = pure (which0Spec);
  -> which14Spec: CommandSpec = pure (which14Spec);
  -> which12Spec: CommandSpec = pure (which12Spec);
  -> eraser0Spec: CommandSpec = pure (eraser0Spec);
  -> eraser14Spec: CommandSpec = pure (eraser14Spec);
  -> eraser12Spec: CommandSpec = pure (eraser12Spec);
  where let
    shots = "100";
    open0Spec = {
      name = "open phase 0";
      target = "examples/wire/quantum-eraser-open-phase-0.wire";
      argv = ["wire-quantum-ibm-rest", "examples/wire/quantum-eraser-open-phase-0.wire", "--shots", shots, "--confirm-hardware", "--json"];
      cwd = ".";
      required = true;
      skip = false;
      echo = false;
    };
    open14Spec = {
      name = "open phase 1/4";
      target = "examples/wire/quantum-eraser-open-phase-1_4.wire";
      argv = ["wire-quantum-ibm-rest", "examples/wire/quantum-eraser-open-phase-1_4.wire", "--shots", shots, "--confirm-hardware", "--json"];
      cwd = ".";
      required = true;
      skip = false;
      echo = false;
    };
    open12Spec = {
      name = "open phase 1/2";
      target = "examples/wire/quantum-eraser-open-phase-1_2.wire";
      argv = ["wire-quantum-ibm-rest", "examples/wire/quantum-eraser-open-phase-1_2.wire", "--shots", shots, "--confirm-hardware", "--json"];
      cwd = ".";
      required = true;
      skip = false;
      echo = false;
    };
    which0Spec = {
      name = "which-path phase 0";
      target = "examples/wire/quantum-eraser-which-path-phase-0.wire";
      argv = ["wire-quantum-ibm-rest", "examples/wire/quantum-eraser-which-path-phase-0.wire", "--shots", shots, "--confirm-hardware", "--json"];
      cwd = ".";
      required = true;
      skip = false;
      echo = false;
    };
    which14Spec = {
      name = "which-path phase 1/4";
      target = "examples/wire/quantum-eraser-which-path-phase-1_4.wire";
      argv = ["wire-quantum-ibm-rest", "examples/wire/quantum-eraser-which-path-phase-1_4.wire", "--shots", shots, "--confirm-hardware", "--json"];
      cwd = ".";
      required = true;
      skip = false;
      echo = false;
    };
    which12Spec = {
      name = "which-path phase 1/2";
      target = "examples/wire/quantum-eraser-which-path-phase-1_2.wire";
      argv = ["wire-quantum-ibm-rest", "examples/wire/quantum-eraser-which-path-phase-1_2.wire", "--shots", shots, "--confirm-hardware", "--json"];
      cwd = ".";
      required = true;
      skip = false;
      echo = false;
    };
    eraser0Spec = {
      name = "eraser phase 0";
      target = "examples/wire/quantum-eraser-round.wire";
      argv = ["wire-quantum-ibm-rest", "examples/wire/quantum-eraser-round.wire", "--shots", shots, "--confirm-hardware", "--json"];
      cwd = ".";
      required = true;
      skip = false;
      echo = false;
    };
    eraser14Spec = {
      name = "eraser phase 1/4";
      target = "examples/wire/quantum-eraser-eraser-phase-1_4.wire";
      argv = ["wire-quantum-ibm-rest", "examples/wire/quantum-eraser-eraser-phase-1_4.wire", "--shots", shots, "--confirm-hardware", "--json"];
      cwd = ".";
      required = true;
      skip = false;
      echo = false;
    };
    eraser12Spec = {
      name = "eraser phase 1/2";
      target = "examples/wire/quantum-eraser-eraser-phase-1_2.wire";
      argv = ["wire-quantum-ibm-rest", "examples/wire/quantum-eraser-eraser-phase-1_2.wire", "--shots", shots, "--confirm-hardware", "--json"];
      cwd = ".";
      required = true;
      skip = false;
      echo = false;
    };
  in
  { inherit open0Spec open14Spec open12Spec which0Spec which14Spec which12Spec eraser0Spec eraser14Spec eraser12Spec; };

node run_open_0
  <- open0Spec: CommandSpec;
  -> open0: CommandResult = @cortex.io.command {} (open0Spec);

node run_open_14
  <- open14Spec: CommandSpec;
  <- open0: CommandResult;
  -> open14: CommandResult = @cortex.io.command {} (open14Spec);

node run_open_12
  <- open12Spec: CommandSpec;
  <- open14: CommandResult;
  -> open12: CommandResult = @cortex.io.command {} (open12Spec);

node run_which_0
  <- which0Spec: CommandSpec;
  <- open12: CommandResult;
  -> which0: CommandResult = @cortex.io.command {} (which0Spec);

node run_which_14
  <- which14Spec: CommandSpec;
  <- which0: CommandResult;
  -> which14: CommandResult = @cortex.io.command {} (which14Spec);

node run_which_12
  <- which12Spec: CommandSpec;
  <- which14: CommandResult;
  -> which12: CommandResult = @cortex.io.command {} (which12Spec);

node run_eraser_0
  <- eraser0Spec: CommandSpec;
  <- which12: CommandResult;
  -> eraser0: CommandResult = @cortex.io.command {} (eraser0Spec);

node run_eraser_14
  <- eraser14Spec: CommandSpec;
  <- eraser0: CommandResult;
  -> eraser14: CommandResult = @cortex.io.command {} (eraser14Spec);

node run_eraser_12
  <- eraser12Spec: CommandSpec;
  <- eraser14: CommandResult;
  -> eraser12: CommandResult = @cortex.io.command {} (eraser12Spec);

node summarize_experiment
  <- open0: CommandResult;
  <- open14: CommandResult;
  <- open12: CommandResult;
  <- which0: CommandResult;
  <- which14: CommandResult;
  <- which12: CommandResult;
  <- eraser0: CommandResult;
  <- eraser14: CommandResult;
  <- eraser12: CommandResult;
  -> summary: ExperimentReport = pure (summary);
  where let
    runs = [open0, open14, open12, which0, which14, which12, eraser0, eraser14, eraser12];
    failures = runs |> filter (run: !run.ok);
    statuses = runs |> map (run: "${run.name}=${run.status}") |> joinWith ", ";
    targets = runs |> map (run: run.target) |> joinWith "\n  ";
    success = length failures == 0;
    summary = if success then
      let
        open0Json = fromJson(open0.stdout);
        open14Json = fromJson(open14.stdout);
        open12Json = fromJson(open12.stdout);
        which0Json = fromJson(which0.stdout);
        which14Json = fromJson(which14.stdout);
        which12Json = fromJson(which12.stdout);
        eraser0Json = fromJson(eraser0.stdout);
        eraser14Json = fromJson(eraser14.stdout);
        eraser12Json = fromJson(eraser12.stdout);
        hasCounts =
          open0Json.complete_counts != null
          && open14Json.complete_counts != null
          && open12Json.complete_counts != null
          && which0Json.complete_counts != null
          && which14Json.complete_counts != null
          && which12Json.complete_counts != null
          && eraser0Json.complete_counts != null
          && eraser14Json.complete_counts != null
          && eraser12Json.complete_counts != null;
      in
      if hasCounts then
        let
          oneBitLine = mode: phase: expected: result:
            let
              counts = result.complete_counts;
              c0 = counts["0"];
              c1 = counts["1"];
              shots = result.shots;
              screenP0 = c0 / shots;
            in
            "  ${mode} | ${phase} | ${screenP0} | ${expected} | - | - | 0:${c0},1:${c1}";
          twoBitLine = mode: phase: expected: result:
            let
              counts = result.complete_counts;
              c00 = counts["00"];
              c01 = counts["01"];
              c10 = counts["10"];
              c11 = counts["11"];
              shots = result.shots;
              screenP0 = (c00 + c10) / shots;
              marker0Total = c00 + c01;
              marker1Total = c10 + c11;
              marker0P0 = c00 / marker0Total;
              marker1P0 = c10 / marker1Total;
            in
            "  ${mode} | ${phase} | ${screenP0} | ${expected} | ${marker0P0} | ${marker1P0} | 00:${c00},01:${c01},10:${c10},11:${c11}";
          rows = [
            oneBitLine "open" "0" 1 open0Json,
            oneBitLine "open" "1/4" 0.5 open14Json,
            oneBitLine "open" "1/2" 0 open12Json,
            twoBitLine "which_path" "0" 0.5 which0Json,
            twoBitLine "which_path" "1/4" 0.5 which14Json,
            twoBitLine "which_path" "1/2" 0.5 which12Json,
            twoBitLine "eraser" "0" 0.5 eraser0Json,
            twoBitLine "eraser" "1/4" 0.5 eraser14Json,
            twoBitLine "eraser" "1/2" 0.5 eraser12Json
          ];
          table = rows |> joinWith "\n";
        in
        "Wire delayed-choice quantum eraser experiment\nexecution: Wire graph + @cortex.io.command\nbackend: IBM Quantum Runtime REST hardware\nshots per circuit: 100\ncircuits: 9 checked-in Wire files\n\nFiles executed:\n  ${targets}\n\nWhat happened:\nWire planned the sweep, sequenced nine hardware command leaves, parsed each REST JSON result with fromJson, and rendered this analyzer report in a pure Wire node. No Qiskit simulator path is used for the experiment.\n\nThree circular polarizers frame:\n  open: no which-path polarization tag; the screen follows the phase fringe.\n  which_path: opposite circular tags make the alternatives distinguishable, so the unsorted screen marginal sits near 0.5.\n  eraser: the final analyzer projects the circular tags into a common basis. The unsorted screen still stays near 0.5, but the marker-conditioned slices recover complementary fringes.\n\nResults:\n  mode | phase | screen p0 | expected | marker0 p0 | marker1 p0 | counts\n${table}\n\nRun gate: complete"
      else
        "Wire delayed-choice quantum eraser experiment\nexecution: Wire graph + @cortex.io.command\nbackend: IBM Quantum Runtime REST hardware\nshots per circuit: 100\ncircuits: 9 checked-in Wire files\n\nFiles executed:\n  ${targets}\n\nThe IBM REST runner completed, but at least one result did not contain decoded counts. Re-run the failed circuit directly with --json and inspect raw_result.\n\nResults: ${statuses}\nRun gate: result decoder needs attention"
    else
      "Wire delayed-choice quantum eraser experiment\nexecution: Wire graph + @cortex.io.command\nbackend: IBM Quantum Runtime REST hardware\nshots per circuit: 100\ncircuits: 9 checked-in Wire files\n\nFiles executed:\n  ${targets}\n\nAt least one hardware command failed before analysis, so the pure Wire analyzer did not parse stdout.\n\nResults: ${statuses}\nRun gate: failed";
  in
  { inherit summary; };

node print_report
  <- summary: ExperimentReport;
  = @cortex.io.stdout { newline = true; } (summary);

(
  start_experiment
    => plan_experiment
    => (
      run_open_0
      <> run_open_14
      <> run_open_12
      <> run_which_0
      <> run_which_14
      <> run_which_12
      <> run_eraser_0
      <> run_eraser_14
      <> run_eraser_12
    )
)
<>
(
  run_open_0
    => run_open_14
    => run_open_12
    => run_which_0
    => run_which_14
    => run_which_12
    => run_eraser_0
    => run_eraser_14
    => run_eraser_12
)
<>
(
  (
    run_open_0
    <> run_open_14
    <> run_open_12
    <> run_which_0
    <> run_which_14
    <> run_which_12
    <> run_eraser_0
    <> run_eraser_14
    <> run_eraser_12
  )
    => summarize_experiment
    => print_report
)

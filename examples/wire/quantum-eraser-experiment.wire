# Full delayed-choice quantum eraser experiment scaffold over IBM Runtime REST.
#
# Run:
#
#   nix run .#wire-quantum-eraser -- --confirm-hardware
#
# The experiment graph is Wire. Each command leaf selects one exported circuit
# graph value from this file and submits it through the IBM Runtime REST bridge.
# The final analyzer is a short pure Wire subgraph that parses JSON stdout with fromJson.

use std.io.{@stdout, @command, @writeFile, CommandSpec, CommandResult};

contract ExperimentStart;
contract ExperimentResults {
  open0: CommandResult;
  open14: CommandResult;
  open12: CommandResult;
  which0: CommandResult;
  which14: CommandResult;
  which12: CommandResult;
  eraser0: CommandResult;
  eraser14: CommandResult;
  eraser12: CommandResult;
};
contract ExperimentAnalysis;
contract ExperimentReport;
contract IBMQuantumConfig;
contract Qubit;
contract Bit;

let phase_zero = 0.0;
let phase_quarter = 1.5707963267948966;
let phase_half = 3.141592653589793;
let quantum_sx = @quantum.sx;
let quantum_cz = @quantum.cz;
let quantum_measure_z = @quantum.measure_z;

kind qubit_gate(label: PortLabel, gate: Executor) =
  <- label: Qubit
  -> label: Qubit
  = @gate label;

kind rz_gate(label: PortLabel, angle: Value) =
  <- label: Qubit
  -> label: Qubit = @quantum.rz { payload = label; cfg = { inherit angle; }; };

kind qubit_measure(input: PortLabel, output: PortLabel) =
  <- input: Qubit
  -> output: Bit
  = @quantum_measure_z input;

kind two_qubit_gate(control: PortLabel, target: PortLabel, gate: Executor) =
  <- control: Qubit
  <- target: Qubit
  -> control: Qubit
  -> target: Qubit
  = @gate { inherit control; inherit target; };

kind run_command(spec: PortLabel, result: PortLabel) =
  <- spec: CommandSpec
  -> result: CommandResult = @command spec;

kind command_gate(spec: PortLabel, previous: PortLabel, ready: PortLabel) =
  <- spec: CommandSpec
  <- previous: CommandResult
  -> previous: CommandResult = previous;
  -> ready: CommandSpec = spec;

form first_command(spec: PortLabel, result: PortLabel) = {
  node run = run_command(spec, result);

  run;
};

form gated_command(spec: PortLabel, previous: PortLabel, ready: PortLabel, result: PortLabel) = {
  node gate = command_gate(spec, previous, ready);
  node run = run_command(ready, result);

  gate
    => run;
};

let experiment_source = "examples/wire/quantum-eraser-experiment.wire";
let experiment_report_path = "./wire-quantum-eraser-report.txt";
let experiment_shots = "100";
let emptyText = "";
let spaceText = " ";
let noneText = "none";
let noStderrText = "(empty)";

# Command-spec construction is CorePure; the command leaves remain ordinary
# std.io.command graph nodes.
let hardwareSpec = name: returnName: {
  inherit name;
  target = "${experiment_source}#${returnName}";
  argv = [
    "wire-quantum-ibm-rest",
    experiment_source,
    "--return",
    returnName,
    "--shots",
    experiment_shots,
    "--confirm-hardware",
    "--json"
  ];
  cwd = ".";
  required = true;
  skip = false;
  echo = false;
};

# Report helpers stay in CorePure so the analyzer nodes below only collect,
# normalize, and render values.
let commandRuns = results: [
  results.open0,
  results.open14,
  results.open12,
  results.which0,
  results.which14,
  results.which12,
  results.eraser0,
  results.eraser14,
  results.eraser12
];

let runStatuses = runs:
  runs |> map (run: "${run.name}=${run.status}") |> joinWith ", ";

let runTargets = runs:
  runs |> map (run: run.target) |> joinWith "\n  ";

let failureDetails = failures:
  failures
    |> map (run: ''
      ${run.name}
        exit: ${if run.exitCode == null then noneText else run.exitCode}
        target: ${run.target}
        argv: ${run.argv |> joinWith spaceText}
        stderr: ${if run.stderr == emptyText then noStderrText else run.stderr}

    '')
    |> joinWith "";

let oneBit = result:
  let
    counts = result.complete_counts;
    c0 = counts["0"];
    c1 = counts["1"];
    shots = result.shots;
  in
  { inherit c0 c1 shots; };

let twoBit = result:
  let
    counts = result.complete_counts;
    c00 = counts["00"];
    c01 = counts["01"];
    c10 = counts["10"];
    c11 = counts["11"];
    shots = result.shots;
    screenZero = c00 + c10;
    marker0Total = c00 + c01;
    marker1Total = c10 + c11;
  in
  { inherit c00 c01 c10 c11 shots screenZero marker0Total marker1Total; };

let experimentBits = decoded:
  let
    openBits = [decoded[0], decoded[1], decoded[2]] |> map oneBit;
    whichPathBits = [decoded[3], decoded[4], decoded[5]] |> map twoBit;
    eraserBits = [decoded[6], decoded[7], decoded[8]] |> map twoBit;
  in
  {
    open0 = openBits[0];
    open14 = openBits[1];
    open12 = openBits[2];
    which0 = whichPathBits[0];
    which14 = whichPathBits[1];
    which12 = whichPathBits[2];
    eraser0 = eraserBits[0];
    eraser14 = eraserBits[1];
    eraser12 = eraserBits[2];
  };

let analyzeExperiment = results:
  let
    runs = commandRuns results;
    failures = runs |> filter (run: !run.ok);
    success = length failures == 0;
    statuses = runStatuses runs;
    targets = runTargets runs;
  in
  if success then
    let
      decoded = runs |> map (run: fromJson(run.stdout));
      hasCounts = decoded |> all (result: result.complete_counts != null);
      bits = if hasCounts then experimentBits decoded else null;
    in
    { inherit runs failures success statuses targets decoded hasCounts bits; }
  else
    {
      inherit runs failures success statuses targets;
      decoded = [];
      hasCounts = false;
      bits = null;
    };

let oneRow = mode: phase: expected: bit:
  "  ${mode} | ${phase} | ${bit.c0}/${bit.shots} | ${expected} | - | - | 0:${bit.c0},1:${bit.c1}\n";

let twoRow = mode: phase: expected: bit:
  "  ${mode} | ${phase} | ${bit.screenZero}/${bit.shots} | ${expected} | ${bit.c00}/${bit.marker0Total} | ${bit.c10}/${bit.marker1Total} | 00:${bit.c00},01:${bit.c01},10:${bit.c10},11:${bit.c11}\n";

let resultRows = bits: [
  "  mode | phase | screen=0 | expected screen | marker=0 screen=0 | marker=1 screen=0 | raw counts\n",
  "  ---- | ----- | -------- | --------------- | ----------------- | ----------------- | ----------\n",
  oneRow "open" "0" "bright" bits.open0,
  oneRow "open" "1/4" "balanced" bits.open14,
  oneRow "open" "1/2" "dark" bits.open12,
  twoRow "which_path" "0" "balanced" bits.which0,
  twoRow "which_path" "1/4" "balanced" bits.which14,
  twoRow "which_path" "1/2" "balanced" bits.which12,
  twoRow "eraser" "0" "balanced before sorting" bits.eraser0,
  twoRow "eraser" "1/4" "balanced before sorting" bits.eraser14,
  twoRow "eraser" "1/2" "balanced before sorting" bits.eraser12
] |> joinWith "";

let runBlock = targets: ''
  Run
    source: ${experiment_source}
    execution: one Wire orchestration graph + std.io.command leaves
    backend: IBM Quantum Runtime REST hardware
    shots: ${experiment_shots} per circuit
    circuits: 9 exported graph values selected from this same Wire file
    report file: ${experiment_report_path}

  Circuit graph values submitted
    ${targets}

'';

let reportTitle = ''
  Wire delayed-choice quantum eraser experiment
  =============================================

'';

let openReading = bits: ''
  Open graph: no middle circular tag
    No path marker is inserted between the splitter and recombiner.
    In the circular-polarizer picture, this is the reference stack:
    the screen behaves like the final analyzer with no middle
    which-path filter left in the beam.

    Phase 0: screen=0 appeared ${bits.open0.c0}/${bits.open0.shots} times, the bright fringe.
    Phase 1/4: screen=0 appeared ${bits.open14.c0}/${bits.open14.shots} times, the halfway setting.
    Phase 1/2: screen=0 appeared ${bits.open12.c0}/${bits.open12.shots} times, the dark fringe.

    Those three numbers are the reference interference fringe.

'';

let whichPathReading = bits: ''
  Which-path graph: opposite circular tags left in place
    The marker is the middle polarizer. It tags the two alternatives
    as opposite circular polarizations, so the screen alone can no
    longer combine them into a phase fringe.

    Unsorted screen=0 counts:
      phase 0: ${bits.which0.screenZero}/${bits.which0.shots}
      phase 1/4: ${bits.which14.screenZero}/${bits.which14.shots}
      phase 1/2: ${bits.which12.screenZero}/${bits.which12.shots}

    Instead of following the open fringe ${bits.open0.c0}/${bits.open0.shots}
    -> ${bits.open14.c0}/${bits.open14.shots} -> ${bits.open12.c0}/${bits.open12.shots},
    all three which-path rows sit around half.

    Sorting by the readable marker still does not recover the clean
    fringe:
      phase 0 marker=0: ${bits.which0.c00}/${bits.which0.marker0Total}
      phase 0 marker=1: ${bits.which0.c10}/${bits.which0.marker1Total}
      phase 1/2 marker=0: ${bits.which12.c00}/${bits.which12.marker0Total}
      phase 1/2 marker=1: ${bits.which12.c10}/${bits.which12.marker1Total}

    The circular path labels are still present, so the alternatives
    remain distinguishable.

'';

let eraserReading = bits: ''
  Eraser graph: final analyzer erases the circular tag
    The eraser adds the third polarizer: a final marker analyzer that
    projects the left/right circular tags into a common basis.

    Before sorting by marker, the screen still respects no-signalling:
      phase 0 screen=0: ${bits.eraser0.screenZero}/${bits.eraser0.shots}
      phase 1/4 screen=0: ${bits.eraser14.screenZero}/${bits.eraser14.shots}
      phase 1/2 screen=0: ${bits.eraser12.screenZero}/${bits.eraser12.shots}

    Those unsorted numbers stay near half, so the later analyzer did
    not rewrite the earlier screen distribution.

    The interference returns only after conditioning on the marker.
      phase 0 marker=0: ${bits.eraser0.c00}/${bits.eraser0.marker0Total}
      phase 0 marker=1: ${bits.eraser0.c10}/${bits.eraser0.marker1Total}
      phase 1/2 marker=0: ${bits.eraser12.c00}/${bits.eraser12.marker0Total}
      phase 1/2 marker=1: ${bits.eraser12.c10}/${bits.eraser12.marker1Total}
      phase 1/4 marker=0: ${bits.eraser14.c00}/${bits.eraser14.marker0Total}
      phase 1/4 marker=1: ${bits.eraser14.c10}/${bits.eraser14.marker1Total}

    Phase 0 is bright in marker=0 and dark in marker=1. Phase 1/2
    trades those roles. Phase 1/4 crosses near the middle.

    That is the quantum eraser in the polarized-filter picture: the
    middle circular marker destroys the visible screen fringe, and
    the final analyzer recovers two opposite fringes only when the
    data is sorted by its marker result.

'';

let successReport = analysis:
  let
    bits = analysis.bits;
  in
  ''
    ${reportTitle}${runBlock analysis.targets}What Wire did
      Wire planned the sweep, sequenced nine hardware command leaves,
      selected each circuit with wire build --return, parsed each REST
      JSON result with fromJson, and rendered this analyzer report in a
      pure Wire node. No Qiskit simulator path is used for the experiment.

    Results
    ${resultRows bits}

    Reading the numbers through three circular polarizers
    ${openReading bits}${whichPathReading bits}${eraserReading bits}Run gate: complete
  '';

let decodeWarningReport = analysis: ''
  ${reportTitle}${runBlock analysis.targets}The IBM REST runner completed, but at least one result did not contain decoded counts.
  Re-run the failed circuit directly with --json and inspect raw_result.

  Results
    ${analysis.statuses}

  Run gate: result decoder needs attention
'';

let failureReport = analysis: ''
  ${reportTitle}${runBlock analysis.targets}At least one hardware command failed before analysis, so the pure Wire analyzer did not parse stdout.

  Results
    ${analysis.statuses}

  Failed rows
  ${failureDetails analysis.failures}Run gate: failed
'';

let renderExperimentReport = analysis:
  if analysis.success then
    if analysis.hasCounts then successReport analysis else decodeWarningReport analysis
  else
    failureReport analysis;

# Hardware circuit graph forms for the eraser sweep.
#
# Each exported graph is selected with `wire build --return NAME` by the
# IBM REST command leaves below. The default file-return at the bottom
# remains the experiment orchestration graph.

form quarter_turn(label: PortLabel) = {
  node rz_a = rz_gate(label, phase_quarter);
  node sx = qubit_gate(label, quantum_sx);
  node rz_b = rz_gate(label, phase_quarter);

  rz_a
    => sx
    => rz_b;
};

form open_circuit(phase_angle: Value) = {
  node ibm_runtime_config
    -> config: IBMQuantumConfig = @quantum.ibm_runtime_config { cfg = { path = "quantum-ibm-runtime.local.json"; }; };
  node prepare_screen
    <- config: IBMQuantumConfig
    -> screen: Qubit = @quantum.prepare_zero { payload = { inherit config; }; cfg = { index = 0; }; };
  node phase_screen = rz_gate(screen, phase_angle);
  node measure_screen = qubit_measure(screen, screen);

  let split_path = quarter_turn(screen);
  let recombine_turn = quarter_turn(screen);
  let recombine_path =
    phase_screen
      => recombine_turn
      => measure_screen;

  ibm_runtime_config
    => prepare_screen
    => split_path
    => recombine_path;
};

form marked_circuit(phase_angle: Value, marker_readout: Graph) = {
  node ibm_runtime_config
    -> config: IBMQuantumConfig = @quantum.ibm_runtime_config { cfg = { path = "quantum-ibm-runtime.local.json"; }; };
  node prepare_screen
    <- config: IBMQuantumConfig
    -> control: Qubit = @quantum.prepare_zero { payload = { inherit config; }; cfg = { index = 0; }; };
  node prepare_marker
    -> target: Qubit = @quantum.prepare_zero { cfg = { index = 1; }; };
  node phase_screen = rz_gate(control, phase_angle);
  node mark_cz = two_qubit_gate(control, target, quantum_cz);
  node measure_screen = qubit_measure(control, screen);

  let split_turn = quarter_turn(control);
  let mark_marker_pre = quarter_turn(target);
  let mark_marker_post = quarter_turn(target);
  let recombine_turn = quarter_turn(control);
  let split_path =
    split_turn
      => phase_screen;
  let recombine_screen =
    recombine_turn
      => measure_screen;
  let prepared_screen_path =
    prepare_screen
      => split_path;
  let prepared_marker_path =
    prepare_marker
      => mark_marker_pre;
  let prepared_paths =
    prepared_screen_path
    <> prepared_marker_path;
  let measured_marker =
    mark_marker_post
      => marker_readout;
  let measured_paths =
    recombine_screen
    <> measured_marker;

  ibm_runtime_config
    => prepared_paths
    => mark_cz
    => measured_paths;
};

form which_path_circuit(phase_angle: Value) = {
  node z_measure_marker = qubit_measure(target, marker);

  let marker_readout = z_measure_marker;
  let circuit = marked_circuit(phase_angle, marker_readout);

  circuit;
};

form eraser_circuit(phase_angle: Value) = {
  node z_measure_marker = qubit_measure(target, marker);

  let marker_eraser_basis = quarter_turn(target);
  let marker_eraser_readout =
    marker_eraser_basis
      => z_measure_marker;
  let circuit = marked_circuit(phase_angle, marker_eraser_readout);

  circuit;
};

export let open_phase_0 = open_circuit(phase_zero);
export let open_phase_1_4 = open_circuit(phase_quarter);
export let open_phase_1_2 = open_circuit(phase_half);

export let which_path_phase_0 = which_path_circuit(phase_zero);
export let which_path_phase_1_4 = which_path_circuit(phase_quarter);
export let which_path_phase_1_2 = which_path_circuit(phase_half);

export let eraser_phase_0 = eraser_circuit(phase_zero);
export let eraser_phase_1_4 = eraser_circuit(phase_quarter);
export let eraser_phase_1_2 = eraser_circuit(phase_half);

node start_experiment
  -> start: ExperimentStart = "start";

node plan_experiment
  <- start: ExperimentStart
  -> open0Spec: CommandSpec = hardwareSpec "open phase 0" "open_phase_0";
  -> open14Spec: CommandSpec = hardwareSpec "open phase 1/4" "open_phase_1_4";
  -> open12Spec: CommandSpec = hardwareSpec "open phase 1/2" "open_phase_1_2";
  -> which0Spec: CommandSpec = hardwareSpec "which-path phase 0" "which_path_phase_0";
  -> which14Spec: CommandSpec = hardwareSpec "which-path phase 1/4" "which_path_phase_1_4";
  -> which12Spec: CommandSpec = hardwareSpec "which-path phase 1/2" "which_path_phase_1_2";
  -> eraser0Spec: CommandSpec = hardwareSpec "eraser phase 0" "eraser_phase_0";
  -> eraser14Spec: CommandSpec = hardwareSpec "eraser phase 1/4" "eraser_phase_1_4";
  -> eraser12Spec: CommandSpec = hardwareSpec "eraser phase 1/2" "eraser_phase_1_2";

let run_open_0 = first_command(open0Spec, open0);
let run_open_14 = gated_command(open14Spec, open0, open14Ready, open14);
let run_open_12 = gated_command(open12Spec, open14, open12Ready, open12);
let run_which_0 = gated_command(which0Spec, open12, which0Ready, which0);
let run_which_14 = gated_command(which14Spec, which0, which14Ready, which14);
let run_which_12 = gated_command(which12Spec, which14, which12Ready, which12);
let run_eraser_0 = gated_command(eraser0Spec, which12, eraser0Ready, eraser0);
let run_eraser_14 = gated_command(eraser14Spec, eraser0, eraser14Ready, eraser14);
let run_eraser_12 = gated_command(eraser12Spec, eraser14, eraser12Ready, eraser12);

node analyze_experiment
  <- results: ExperimentResults
  -> analysis: ExperimentAnalysis = analyzeExperiment results;

node render_experiment_report
  <- analysis: ExperimentAnalysis
  -> print_summary: ExperimentReport = summary;
  -> write_summary: ExperimentReport = summary;
  where let
    summary = renderExperimentReport analysis;
  in
  { inherit summary; };

node print_report
  <- print_summary: ExperimentReport
  = @stdout { payload = print_summary; cfg = { newline = true; }; };

node write_report
  <- write_summary: ExperimentReport
  = @writeFile { payload = write_summary; cfg = { path = "./wire-quantum-eraser-report.txt"; }; };

let command_sequence =
  run_open_0
    => run_open_14
    => run_open_12
    => run_which_0
    => run_which_14
    => run_which_12
    => run_eraser_0
    => run_eraser_14
    => run_eraser_12;

let analyzed_sequence =
  command_sequence
    * analyze_experiment;

start_experiment
  => plan_experiment
  => analyzed_sequence
  => render_experiment_report
  => print_report <> write_report

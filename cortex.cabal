    import:           shared-properties, runtime-library-deps
    visibility:       public
    hs-source-dirs:   src-logos
    autogen-modules:  Paths_cortex
    build-depends:
        cortex,
        cortex:platform-runtime
    other-modules:
        Paths_cortex
    exposed-modules:
        Logos
        Logos.Archetypes

cabal-version:      3.0
name:               cortex
version:            0.1.0.0
synopsis:           Durable runtime substrate for typed dataflow programs
description:
    Cortex is a durable runtime substrate for typed-dataflow programs:
    Graph algebra, Circuit validation, Wire source language, Pulse
    executor, memory substrate, and capability abstractions.

license:            Apache-2.0
license-file:       LICENSE
author:             Julius Koskela
maintainer:         julius.koskela@digimuoto.com
copyright:          2026 Digimuoto Oy
category:           Runtime
build-type:         Simple
extra-source-files:
    README.md
    NOTICE

common shared-properties
    default-language: GHC2024
    default-extensions:
        DeriveAnyClass
        DerivingVia
        DuplicateRecordFields
        OverloadedRecordDot
        OverloadedStrings
        RecordWildCards
        TypeFamilies
    ghc-options:
        -Wall
        -Wextra
        -Werror
        -Wcompat
        -Widentities
        -Wincomplete-record-updates
        -Wincomplete-uni-patterns
        -Wmissing-export-lists
        -Wmissing-home-modules
        -Wpartial-fields
        -Wredundant-constraints
        -Werror=missing-fields
        -Werror=unused-imports
        -fno-warn-orphans

common runtime-library-deps
    build-depends:
        base >=4.16 && <5,
        -- General Utilities
        text >=2.0,
        bytestring >=0.11,
        deepseq >=1.4,
        base16-bytestring >=1.0,
        base64-bytestring >=1.2,
        uuid >=1.3,
        uuid-types >=1.0,
        time >=1.12,
        scientific >=0.3,
        containers >=0.6,
        vector >=0.13,
        insert-ordered-containers >=0.2,
        unordered-containers >=0.2,
        mtl >=2.2,
        transformers >=0.6,
        exceptions >=0.10,
        async >=2.2,
        stm >=2.5,
        random >=1.2,
        unix >=2.8,
        retry >=0.9,
        filepath >=1.4,
        directory >=1.3,
        temporary >=1.3,
        process >=1.6,
        -- JSON / YAML
        aeson >=2.1,
        aeson-pretty >=0.8,
        yaml >=0.11,

        -- Database (used by Cortex persistence and the external Platform package)
        rel8 >=1.4,
        hasql >=1.6,
        hasql-pool >=0.10,
        hasql-transaction >=1.0,
        resource-pool >=0.4,

        -- HTTP client + WAI middleware
        -- (Cortex.Capability.Provider.OpenRouter and the external Platform package)
        servant-server >=0.20,
        servant-client-core >=0.20,
        openapi3 >=3.2,
        http-client >=0.7,
        http-client-tls >=0.3,
        http-api-data >=0.5,
        http-types >=0.12,
        case-insensitive >=1.2,
        wai >=3.2,
        warp >=3.3,

        -- Crypto (external Platform package: AES-256-GCM, HKDF, SHA256).
        -- Keep `Data.ByteArray.Bytes` aligned with crypton's AuthTag type.
        crypton >=0.34 && <1,
        memory >=0.18,

        -- Money (Cortex value modules)
        safe-money >=0.9,
        safe-money-aeson >=0.1,

        -- CLI / terminal
        optparse-applicative >=0.17,
        ansi-terminal >=1.0,
        prettyprinter >=1.7,

        -- Template Haskell & Lenses
        template-haskell >=2.18,
        lens >= 5.2,
        microlens >=0.4,
        microlens-th >=0.4,

        -- Logging & Config
        fast-logger >=3.1,
        monad-logger >=0.3,
        configurator >=0.3,

        -- Markdown rendering
        cmark-gfm >=0.2.5

-- Main library: Cortex substrate.
library
    import:           shared-properties, runtime-library-deps
    hs-source-dirs:   src
    autogen-modules:  Paths_cortex
    build-depends:
        haskell-platform,
        megaparsec >=9.2
    other-modules:
        Paths_cortex
        Cortex.Wire.AST
        Cortex.Wire.Contracts
        Cortex.Wire.Proposal
        Cortex.Wire.Runtime
        Cortex.Wire.Value
    exposed-modules:
        Cortex
        Cortex.Algebra
        Cortex.Algebra.Graph
        Cortex.Algebra.Graph.Core
        Cortex.Algebra.Graph.Decompose
        Cortex.Algebra.Graph.Influence
        Cortex.Algebra.Graph.Modify
        Cortex.Algebra.Graph.Mokhov
        Cortex.Algebra.Graph.Search
        Cortex.Algebra.Graph.Validate
        Cortex.Artifact
        Cortex.Artifact.Host
        Cortex.Artifact.IR
        Cortex.Artifact.Metadata
        Cortex.Capability
        Cortex.Capability.Executor
        Cortex.Capability.Executor.Pure
        Cortex.Capability.Model
        Cortex.Capability.Model.Client
        Cortex.Capability.Model.Message
        Cortex.Capability.Model.Output
        Cortex.Capability.Model.Types
        Cortex.Capability.Provider
        Cortex.Capability.Provider.OpenRouter
        Cortex.Capability.Provider.OpenRouter.Client
        Cortex.Capability.Provider.OpenRouter.Embedding
        Cortex.Capability.Provider.OpenRouter.Wire
        Cortex.Capability.StructuredOutput
        Cortex.Capability.Tool
        Cortex.Capability.Tool.Definition
        Cortex.Capability.Tool.Record
        Cortex.Pulse
        Cortex.Pulse.Attempt
        Cortex.Pulse.Checkpoint
        Cortex.Pulse.Database
        Cortex.Pulse.Event
        Cortex.Pulse.Executor
        Cortex.Pulse.Executor.Attempt
        Cortex.Pulse.Executor.Events
        Cortex.Pulse.Executor.Frontier
        Cortex.Pulse.Executor.Loop
        Cortex.Pulse.Executor.Outcome
        Cortex.Pulse.Executor.Persistence
        Cortex.Pulse.Executor.ReplayPolicy
        Cortex.Pulse.Executor.Resume
        Cortex.Pulse.Executor.Types
        Cortex.Pulse.Frontier
        Cortex.Pulse.GraphStateRevision
        Cortex.Pulse.Hydrate
        Cortex.Pulse.Materialize
        Cortex.Pulse.Outcome
        Cortex.Pulse.Persistence
        Cortex.Pulse.Replay
        Cortex.Pulse.Resume
        Cortex.Pulse.Runtime
        Cortex.Wire
        Cortex.Wire.Compile
        Cortex.Wire.Contract
        Cortex.Wire.Executor
        Cortex.Wire.Parser
        Cortex.Wire.Pure
        Cortex.Wire.Syntax
        Cortex.Wire.Circuit
        Cortex.Wire.Circuit.Artifact
        Cortex.Wire.Circuit.Compile
        Cortex.Wire.Circuit.Compiled
        Cortex.Wire.Circuit.Compiler
        Cortex.Wire.Circuit.IR
        Cortex.Wire.Circuit.Lower
        Cortex.Wire.Circuit.Lowering
        Cortex.Wire.Circuit.Node
        Cortex.Wire.Circuit.NodeKind
        Cortex.Pulse.GraphRuntime
        Cortex.Pulse.Health
        Cortex.Pulse.Materialization
        Cortex.Pulse.Memory
        Cortex.Pulse.Memory.Query
        Cortex.Pulse.Memory.Score
        Cortex.Pulse.Memory.Tool
        Cortex.Pulse.Memory.Types
        Cortex.Pulse.Memory.Walk
        Cortex.Pulse.Node
        Cortex.Pulse.Plan
        Cortex.Pulse.PlanHydration
        Cortex.Pulse.Query
        Cortex.Pulse.Rewrite
        Cortex.Pulse.Schema
        Cortex.Pulse.Signal
        Cortex.Pulse.Scheduler
        Cortex.Pulse.Types

-- Pulse executor binary: substrate shell.
-- Ships with an empty task registry; downstream consumers link their own.
executable cortex-pulse
    import:           shared-properties
    hs-source-dirs:   app/cortex-pulse
    main-is:          Main.hs
    build-depends:
        base >=4.16 && <5,
        cortex,
        haskell-platform,
        optparse-applicative >=0.17,
        text >=2.0,
        bytestring >=0.11,
        containers >=0.6
    ghc-options:      -threaded -rtsopts -with-rtsopts=-N

-- Cortex test suite (hspec-discover).
test-suite cortex-test
    import:           shared-properties
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    build-tool-depends:
        hspec-discover:hspec-discover >=2.10
    other-modules:
        Cortex.Algebra.GraphSpec
        Cortex.Artifact.IRSpec
        Cortex.CanonicalModuleTreeSpec
        Cortex.Capability.Executor.PureSpec
        Cortex.Capability.Provider.OpenRouterSpec
        Cortex.Capability.StructuredOutputSpec
        Cortex.PublicPreludeSpec
        Cortex.Pulse.CheckpointSpec
        Cortex.Pulse.RewriteAnchorValidationSpec
        Cortex.Pulse.RewriteRetryHydrationSpec
        Cortex.Pulse.StageTemplateRegistrySpec
        Cortex.Pulse.Executor.EventsSpec
        Cortex.Pulse.ExecutorSpec
        Cortex.Pulse.GraphRewriteSpec
        Cortex.Pulse.MemoryIntegrationSpec
        Cortex.Pulse.MemorySpec
        Cortex.Pulse.MemoryToolSpec
        Cortex.Pulse.SchedulerSpec
        Cortex.Pulse.TypesSpec
        Cortex.TestSupport.Database
        Cortex.Wire.Circuit.CompilerSpec
        Cortex.Wire.Circuit.IRSpec
        Cortex.Wire.CompileSpec
        Cortex.Wire.ParserSpec
        Cortex.Wire.PureSpec
    build-depends:
        base >=4.16 && <5,
        cortex,
        haskell-platform,
        -- Test frameworks
        hspec >=2.10,
        hspec-discover >=2.10,
        HUnit >=1.6,
        QuickCheck >=2.14,
        hedgehog >=1.2,

        -- JSON
        aeson >=2.1,
        aeson-qq >=0.8,

        -- Database (required by integration specs)
        hasql >=1.6,
        hasql-pool >=0.10,
        hasql-transaction >=1.0,
        rel8 >=1.4,
        postgresql-simple >=0.7,

        -- Text and data
        text >=2.0,
        bytestring >=0.11,
        time >=1.12,
        containers >=0.6,
        uuid >=1.3,
        uuid-types >=1.0,
        scientific >=0.3,
        raw-strings-qq >=1.1,

        -- Utilities
        mtl >=2.3,
        transformers >=0.6,
        filepath >=1.4,
        directory >=1.3,
        stm >=2.5,
        async >=2.2
    ghc-options: -threaded -rtsopts -with-rtsopts=-N

-- Pulse executor binary: substrate shell.
-- Ships with an empty task registry; downstream consumers link their own.
executable cortex-pulse
    import:           shared-properties
    hs-source-dirs:   app/cortex-pulse
    main-is:          Main.hs
    build-depends:
        base >=4.16 && <5,
        cortex,
        cortex:platform-runtime,
        optparse-applicative >=0.17,
        text >=2.0,
        bytestring >=0.11,
        containers >=0.6
    ghc-options:      -threaded -rtsopts -with-rtsopts=-N

-- Cortex-only test suite (hspec-discover).
-- Filtered from portman-test to Cortex.* and Platform.DurableTask.* specs.
test-suite cortex-test
    import:           shared-properties
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    build-tool-depends:
        hspec-discover:hspec-discover >=2.10
    other-modules:
        Cortex.Algebra.GraphSpec
        Cortex.Artifact.IRSpec
        Cortex.CanonicalModuleTreeSpec
        Cortex.Capability.Executor.PureSpec
        Cortex.Capability.Provider.OpenRouterSpec
        Cortex.Capability.StructuredOutputSpec
        Cortex.PublicPreludeSpec
        Cortex.Pulse.RewriteAnchorValidationSpec
        Cortex.Pulse.RewriteRetryHydrationSpec
        Cortex.Pulse.StageTemplateRegistrySpec
        Cortex.Pulse.Executor.EventsSpec
        Cortex.Pulse.ExecutorSpec
        Cortex.Pulse.GraphRewriteSpec
        Cortex.Pulse.MemoryIntegrationSpec
        Cortex.Pulse.MemorySpec
        Cortex.Pulse.MemoryToolSpec
        Cortex.Pulse.SchedulerSpec
        Cortex.Pulse.TypesSpec
        Cortex.TestSupport.Database
        Cortex.Wire.Circuit.CompilerSpec
        Cortex.Wire.Circuit.IRSpec
        Cortex.Wire.CompileSpec
        Cortex.Wire.ParserSpec
        Cortex.Wire.PureSpec
        Platform.DurableTask.CheckpointSpec
        Platform.DurableTask.CronSpec
        Platform.DurableTask.ErrorSpec
        Platform.DurableTask.PollingSpec
        Platform.DurableTask.PoolSpec
        Platform.DurableTask.ScheduleSpec
        Platform.DurableTask.TypesSpec
    build-depends:
        base >=4.16 && <5,
        cortex,
        cortex:platform-runtime,
        -- Test frameworks
        hspec >=2.10,
        hspec-discover >=2.10,
        HUnit >=1.6,
        QuickCheck >=2.14,
        hedgehog >=1.2,

        -- JSON
        aeson >=2.1,
        aeson-qq >=0.8,

        -- Database (required by integration specs)
        hasql >=1.6,
        hasql-pool >=0.10,
        hasql-transaction >=1.0,
        rel8 >=1.4,
        postgresql-simple >=0.7,

        -- Text and data
        text >=2.0,
        bytestring >=0.11,
        time >=1.12,
        containers >=0.6,
        uuid >=1.3,
        uuid-types >=1.0,
        scientific >=0.3,
        raw-strings-qq >=1.1,

        -- Utilities
        mtl >=2.3,
        transformers >=0.6,
        filepath >=1.4,
        directory >=1.3,
        stm >=2.5,
        async >=2.2
    ghc-options: -threaded -rtsopts -with-rtsopts=-N


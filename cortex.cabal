-- Pulse executor binary: substrate shell.
-- Ships with an empty task registry; downstream consumers link their own.
executable cortex-pulse
    import:           shared-properties
    hs-source-dirs:   app/cortex-pulse
    main-is:          Main.hs
    build-depends:
        base >=4.16 && <5,
        cortex,
        cortex:platform-runtime,
        optparse-applicative >=0.17,
        text >=2.0,
        bytestring >=0.11,
        containers >=0.6
    ghc-options:      -threaded -rtsopts -with-rtsopts=-N

-- Cortex-only test suite (hspec-discover).
-- Filtered from portman-test to Cortex.* and Platform.DurableTask.* specs.
test-suite cortex-test
    import:           shared-properties
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    build-tool-depends:
        hspec-discover:hspec-discover >=2.10
    other-modules:
        Cortex.Agent.ConfigSpec
        Cortex.Circuit.CompilerSpec
        Cortex.Circuit.IRSpec
        Cortex.Document.IRSpec
        Cortex.GraphSpec
        Cortex.Memory.CandidatesSpec
        Cortex.Memory.ConflictSpec
        Cortex.Memory.DocumentSpec
        Cortex.Memory.PackSpec
        Cortex.Memory.QuerySpec
        Cortex.Memory.RankSpec
        Cortex.Memory.RetrieveSpec

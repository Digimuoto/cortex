-- In-repo downstream quantum extension (ADR 0060). The vendor, authority-bearing
-- AWS Braket host runtime binding pack lives here, depending on Cortex core rather
-- than being exposed by it. Cortex core ships no downstream package identity.
library cortex-quantum
    import:           shared-properties
    visibility:       public
    hs-source-dirs:   extensions/quantum/src
    build-depends:
        base >=4.16 && <5,
        cortex,
        aeson >=2.1,
        bytestring >=0.11,
        containers >=0.6,
        crypton >=0.34 && <1,
        filepath >=1.4,
        process >=1.6,
        scientific >=0.3,
        text >=2.0,
        time >=1.12
    exposed-modules:
        Cortex.Capability.BindingPack.Braket
        Cortex.Quantum.Braket
        Cortex.Quantum.Compile
        Cortex.Quantum.Cost
        Cortex.Quantum.Diagram
        Cortex.Quantum.OpenQASM
        Cortex.Quantum.Plan
        Cortex.Quantum.Provenance
        Cortex.Quantum.Qec
        Cortex.Quantum.ReportPath
        Cortex.Quantum.Result

-- Test harness sublibrary (#331): ephemeral Postgres provisioning + a ready Pulse
-- TaskContext, published so downstream consumers test compiled-circuit execution
-- without replicating Cortex's DB lifecycle. Depends on cortex; not used by it.
library cortex-testkit
    import:           shared-properties
    visibility:       public
    hs-source-dirs:   testkit/src
    build-depends:
        base >=4.16 && <5,
        cortex,
        haskell-platform,
        containers >=0.6,
        text >=2.0,
        uuid >=1.3,
        stm >=2.5,
        hasql >=1.6,
        hasql-pool >=0.10,
        hasql-transaction >=1.0,
        HUnit >=1.6
    exposed-modules:
        Cortex.TestSupport.Database
        Cortex.TestSupport.Pulse

-- Pulse executor binary: substrate shell.
-- Ships with an empty task registry; downstream consumers link their own.
executable cortex-pulse
    import:           shared-properties
    hs-source-dirs:   app/cortex-pulse
    main-is:          Main.hs
    build-depends:
        base >=4.16 && <5,
        cortex,
        haskell-platform,
        optparse-applicative >=0.17,
        text >=2.0,
        bytestring >=0.11,
        containers >=0.6
    ghc-options:      -threaded -rtsopts -with-rtsopts=-N

-- Wire source CLI: local build/run workflows for .wire files.
executable wire
    import:           shared-properties
    hs-source-dirs:   app/wire
    main-is:          Main.hs
    autogen-modules:  Paths_cortex
    other-modules:    Paths_cortex
    build-depends:
        base >=4.16 && <5,
        cortex,
        aeson >=2.1,
        aeson-pretty >=0.8,
        async >=2.2,
        bytestring >=0.11,
        containers >=0.6,
        directory >=1.3,
        filepath >=1.4,
        process >=1.6,
        text >=2.0
    ghc-options:      -threaded -rtsopts -with-rtsopts=-N

-- Native Wire -> Amazon Braket OpenQASM single-circuit runner (ADR 0060 quantum
-- showcase). Shells out to the AWS CLI; the CLI path arrives via CORTEX_AWS_BIN.
executable wire-quantum-braket
    import:           shared-properties
    hs-source-dirs:   app/wire-quantum-braket
    main-is:          Main.hs
    build-depends:
        base >=4.16 && <5,
        cortex,
        cortex:cortex-quantum,
        aeson >=2.1,
        aeson-pretty >=0.8,
        bytestring >=0.11,
        text >=2.0
    ghc-options:      -threaded -rtsopts -with-rtsopts=-N

-- Native distance-3 repetition-code QEC sweep over the Braket runner.
executable wire-quantum-qec-repetition-braket
    import:           shared-properties
    hs-source-dirs:   app/wire-quantum-qec-repetition-braket
    main-is:          Main.hs
    build-depends:
        base >=4.16 && <5,
        cortex,
        cortex:cortex-quantum,
        aeson >=2.1,
        aeson-pretty >=0.8,
        bytestring >=0.11,
        directory >=1.3,
        filepath >=1.4,
        text >=2.0,
        time >=1.12
    ghc-options:      -threaded -rtsopts -with-rtsopts=-N

-- Criterion benchmarks for the CorePure evaluator.
benchmark pure-wire-bench
    import:           shared-properties
    type:             exitcode-stdio-1.0
    hs-source-dirs:   bench/pure-wire
    main-is:          Main.hs
    build-depends:
        base >=4.16 && <5,
        cortex,
        aeson >=2.1,
        containers >=0.6,
        criterion >=1.6 && <1.7,
        deepseq >=1.4,
        scientific >=0.3,
        text >=2.0,
        vector >=0.13
    ghc-options:      -O2 -threaded -rtsopts -with-rtsopts=-N

-- Cortex test suite (hspec-discover).
test-suite cortex-test
    import:           shared-properties
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    build-tool-depends:
        hspec-discover:hspec-discover >=2.10
    other-modules:
        Cortex.Algebra.GraphSpec

        cortex,
        cortex:platform-runtime,
        -- Test frameworks
        hspec >=2.10,
        hspec-discover >=2.10,
        HUnit >=1.6,
        QuickCheck >=2.14,
        hedgehog >=1.2,

        -- JSON
        aeson >=2.1,
        aeson-qq >=0.8,

        -- Database (required by integration specs)
        hasql >=1.6,
        hasql-pool >=0.10,
        hasql-transaction >=1.0,
        rel8 >=1.4,

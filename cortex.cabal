cabal-version:      3.0
name:               cortex
version:            0.1.0.0
synopsis:           Durable runtime substrate for typed dataflow programs
description:
    Cortex is a durable runtime substrate for typed-dataflow programs:
    Graph algebra, Circuit validation, Wire source language, Pulse
    executor, memory substrate, and capability abstractions.

license:            Apache-2.0
license-file:       LICENSE
author:             Julius Koskela
maintainer:         julius.koskela@digimuoto.com
copyright:          2026 Digimuoto Oy
category:           Runtime
build-type:         Simple
extra-source-files:
    README.md
    NOTICE

-- Pulse-owned schema shipped as a library data-file (ADR 0003); applied by
-- Cortex.Pulse.Database.provisionPulseSchema via Paths_cortex.getDataFileName.
data-dir:           data
data-files:         pulse-schema.sql

common shared-properties
    default-language: GHC2024
    default-extensions:
        DeriveAnyClass
        DerivingVia
        DuplicateRecordFields
        ImportQualifiedPost
        OverloadedRecordDot
        OverloadedStrings
        RecordWildCards
        TypeFamilies
    ghc-options:
        -Wall
        -Wextra
        -Werror
        -Wcompat
        -Widentities
        -Wincomplete-record-updates
        -Wincomplete-uni-patterns
        -Wmissing-export-lists
        -Wmissing-home-modules
        -Wpartial-fields
        -Wredundant-constraints
        -Werror=missing-fields
        -Werror=unused-imports
        -fno-warn-orphans

common runtime-library-deps
    build-depends:
        base >=4.16 && <5,
        -- General Utilities
        text >=2.0,
        bytestring >=0.11,
        deepseq >=1.4,
        base16-bytestring >=1.0,
        base64-bytestring >=1.2,
        uuid >=1.3,
        uuid-types >=1.0,
        time >=1.12,
        scientific >=0.3,
        containers >=0.6,
        vector >=0.13,
        insert-ordered-containers >=0.2,
        unordered-containers >=0.2,
        mtl >=2.2,
        transformers >=0.6,
        exceptions >=0.10,
        async >=2.2,
        stm >=2.5,
        random >=1.2,
        unix >=2.8,
        filepath >=1.4,
        directory >=1.3,
        temporary >=1.3,
        process >=1.6,
        -- JSON / YAML
        aeson >=2.1,
        aeson-pretty >=0.8,
        toml-parser >=2.0,
        yaml >=0.11,

        -- Database (used by Cortex persistence and the external Platform package)
        rel8 >=1.4,
        hasql >=1.6,
        hasql-pool >=0.10,
        hasql-transaction >=1.0,
        resource-pool >=0.4,

        -- HTTP / WAI middleware
        openapi3 >=3.2,
        http-types >=0.12,
        wai >=3.2,
        warp >=3.3,

        -- Crypto (external Platform package: AES-256-GCM, HKDF, SHA256).
        -- Keep `Data.ByteArray.Bytes` aligned with crypton's AuthTag type.
        crypton >=0.34 && <1,
        memory >=0.18,

        -- CLI / terminal
        optparse-applicative >=0.17,
        ansi-terminal >=1.0,
        prettyprinter >=1.7,

        -- Template Haskell & Lenses
        template-haskell >=2.18,
        lens >= 5.2,
        microlens >=0.4,
        microlens-th >=0.4,

        -- Logging & Config
        fast-logger >=3.1,
        monad-logger >=0.3,
        configurator >=0.3


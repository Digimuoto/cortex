  writeSkill = name: files:
    pkgs.runCommand "cortex-agent-skill-${name}" {} (
      ''
        set -eu
        mkdir -p "$out"
      ''
      + lib.concatStringsSep "\n" (
        lib.mapAttrsToList (
          relativePath: encoded: ''
            target="$out/${relativePath}"
            mkdir -p "$(${pkgs.coreutils}/bin/dirname "$target")"
            ${pkgs.coreutils}/bin/base64 --decode > "$target" <<'EOF'
            ${encoded}
            EOF
          ''
        )
        files
      )
    );
in
  lib.mapAttrs writeSkill skillFiles

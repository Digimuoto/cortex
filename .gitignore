# =============================================================================
# WHITELIST GITIGNORE
# =============================================================================
#
# Pattern: Ignore everything (*), then explicitly allow tracked items (!path).
# =============================================================================

*

# === Directories ===

# Haskell library source
!src/
!src/**
!app/
!app/**
!test/
!test/**
!bench/
!bench/**

# agents/ — slash-command skills for AI coding agents
!agents/
!agents/**

# theory/ — Lean 4 mechanization (lake-managed; .lake/ is the build cache)
!theory/
!theory/**
theory/.lake/

# formal/ — TLA+ protocol models (model-checked with TLC)
!formal/
!formal/**

# docs/ — flat markdown tree consumed by repo-docs
!docs/
!docs/**

# examples/ — runnable examples and smoke fixtures
!examples/
!examples/**

# extensions/ — in-repo downstream extension workbenches
!extensions/
!extensions/**

# nix/ — includes materialized/ for reproducible builds
!nix/
!nix/**

# migrations/ — forward DDL for deployed pulse DBs (no in-repo runner; applied out of band)
!migrations/
!migrations/**

# data/ — cortex library data-files shipped with the package
# (e.g. pulse-schema.sql, applied by Cortex.Pulse.Database.provisionPulseSchema; ADR 0003)
!data/
!data/**

# editors/ — tree-sitter-wire grammar + editor integrations
!editors/
!editors/**
editors/tree-sitter-wire/node_modules
editors/tree-sitter-wire/build
editors/tree-sitter-wire/target

# CI
!/.github/
!/.github/**

# Repo-local maintenance scripts
!scripts/
!scripts/**

# === Root Files (anchored with /) ===
!/.envrc
!/.gitignore
!/.hlint.yaml
!/LICENSE
!/NOTICE
!/README.md
!/CONTRIBUTING.md
!/cabal.project
!/cortex.cabal
!/flake.lock
!/flake.nix
!/fourmolu.yaml
!/justfile

# === Exclusions (re-ignore in whitelisted dirs) ===

# Generated provider context symlinks. Canonical context lives in agents/.
AGENTS.md
CLAUDE.md
GEMINI.md

*.local.json
*.hi
*.o
*.dyn_hi
*.dyn_o

# Documentation build artifacts
docs/dist/
docs/.astro/
docs/node_modules/
docs/package-lock.json

# Generated artifacts from runnable examples
examples/wire/c-build/build
examples/wire/c-build/build/
examples/wire/c-build/dist
examples/wire/c-build/dist/

# Cabal / GHC
dist-newstyle/
dist/
.ghc.environment.*
.hie/

# Tree-sitter cache
.cache/

# Local quantum runner outputs and credentials
wire-qec-repetition-report.txt
braket-env.local.sh

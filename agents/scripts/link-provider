#!/usr/bin/env sh
set -eu

usage() {
  echo "usage: agents/scripts/link-provider codex|claude|opencode" >&2
  exit 2
}

provider="${1:-}"
case "$provider" in
  codex|claude|opencode) ;;
  *) usage ;;
esac

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

ensure_dir() {
  dir="$1"

  if [ -d "$dir" ]; then
    return
  fi

  if [ -e "$dir" ] || [ -L "$dir" ]; then
    if [ -f "$dir" ] && [ ! -s "$dir" ]; then
      rm "$dir"
    else
      echo "refusing to replace non-directory: ${dir#$repo_root/}" >&2
      exit 1
    fi
  fi

  mkdir -p "$dir"
}

link_rel() {
  target="$1"
  link="$2"
  link_dir="$(dirname "$link")"

  if [ ! -e "$target" ]; then
    echo "missing target: ${target#$repo_root/}" >&2
    exit 1
  fi

  ensure_dir "$link_dir"

  if [ -L "$link" ] || [ -f "$link" ]; then
    rm "$link"
  elif [ -d "$link" ]; then
    echo "refusing to replace directory: ${link#$repo_root/}" >&2
    exit 1
  fi

  rel_target="$(realpath --relative-to="$link_dir" "$target")"
  ln -s "$rel_target" "$link"
  echo "${link#$repo_root/} -> $rel_target"
}

link_contexts() {
  provider_file="$1"

  link_rel "$repo_root/agents/context.md" "$repo_root/$provider_file"
}

link_archetypes() {
  archetype_link="$1"

  link_rel "$repo_root/agents/archetypes" "$archetype_link"
}

link_codex() {
  link_contexts AGENTS.md
  link_archetypes "$repo_root/.codex/archetypes"

  skill_dest="$repo_root/.codex/skills"
  ensure_dir "$skill_dest"

  for skill_dir in "$repo_root"/agents/skills/*; do
    [ -d "$skill_dir" ] || continue
    skill_name="$(basename "$skill_dir")"
    link_rel "$skill_dir" "$skill_dest/$skill_name"
  done
}

link_claude() {
  link_contexts CLAUDE.md
  link_archetypes "$repo_root/.claude/archetypes"

  command_dest="$repo_root/.claude/commands"
  ensure_dir "$command_dest"

  for skill_dir in "$repo_root"/agents/skills/*; do
    [ -d "$skill_dir" ] || continue
    skill_name="$(basename "$skill_dir")"
    link_rel "$skill_dir/SKILL.md" "$command_dest/$skill_name.md"
  done
}

link_opencode() {
  link_contexts AGENTS.md
  link_archetypes "$repo_root/.opencode/archetypes"

  skill_dest="$repo_root/.opencode/skills"
  ensure_dir "$skill_dest"

  for skill_dir in "$repo_root"/agents/skills/*; do
    [ -d "$skill_dir" ] || continue
    skill_name="$(basename "$skill_dir")"
    link_rel "$skill_dir" "$skill_dest/$skill_name"
  done
}

case "$provider" in
  codex) link_codex ;;
  claude) link_claude ;;
  opencode) link_opencode ;;
esac

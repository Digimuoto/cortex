# Grammar flagship example — parallel claim branches with explicit typed
# executor boundaries and explicit pure fan-in/fan-out.

# ---- shared instruction blocks ----

let topo_awareness = ''
  You have access to the full upstream substrate via topological memory.
  Claim discipline is enforced by executor config, not by information availability.
'';

let weak_evidence_rule = ''
  If contrary evidence is genuinely weak across the substrate, state
  that explicitly as a finding with its own section.
'';

let citation_rule = ''Cite evidenceRefs by toolCallId for every concrete claim.'';

let analyst_suffix = topo_awareness ++ weak_evidence_rule ++ citation_rule;

# ---- nodes ----

node planner
  -> mechanism_plan: PlannerOutput | timing_plan: PlannerOutput | beneficiaries_plan: PlannerOutput | planner_error: ExecutorError
  = @review.planner;

node gatherer_mechanism with {
  memory = topological { preset = "causal"; };
  tools = [getDate, searchAssets, getAssetFundamentals, webSearch];
}
  <- mechanism_plan: PlannerOutput
  -> mechanism: EvidenceBundle | gatherer_mechanism_error: ExecutorError
  = @review.gatherer mechanism_plan;

node gatherer_timing with {
  memory = topological { preset = "causal"; };
  tools = [getDate, searchAssets, getAssetNews, webSearch];
}
  <- timing_plan: PlannerOutput
  -> timing: EvidenceBundle | gatherer_timing_error: ExecutorError
  = @review.gatherer timing_plan;

node gatherer_beneficiaries with {
  memory = topological { preset = "causal"; };
  tools = [getDate, searchAssets, getAnalystRatingChanges, webSearch];
}
  <- beneficiaries_plan: PlannerOutput
  -> beneficiaries: EvidenceBundle | gatherer_beneficiaries_error: ExecutorError
  = @review.gatherer beneficiaries_plan;

node analyst_mechanism with {
  maxOutputTokens = 16384;
  memory = topological { preset = "causal"; };
  instructions = ''Attack the mechanism leg.'' ++ analyst_suffix;
}
  <- mechanism: EvidenceBundle
  -> mechanism_fragment: AnalysisFragment | analyst_mechanism_error: ExecutorError
  = @review.analyst mechanism;

node analyst_timing with {
  maxOutputTokens = 16384;
  memory = topological { preset = "causal"; };
  instructions = ''Attack the timing leg.'' ++ analyst_suffix;
}
  <- timing: EvidenceBundle
  -> timing_fragment: AnalysisFragment | analyst_timing_error: ExecutorError
  = @review.analyst timing;

node analyst_beneficiaries with {
  maxOutputTokens = 16384;
  memory = topological { preset = "causal"; };
  instructions = ''Attack the beneficiary leg.'' ++ analyst_suffix;
}
  <- beneficiaries: EvidenceBundle
  -> beneficiaries_fragment: AnalysisFragment | analyst_beneficiaries_error: ExecutorError
  = @review.analyst beneficiaries;

node merge
  <- mechanism_fragment: AnalysisFragment
  <- timing_fragment: AnalysisFragment
  <- beneficiaries_fragment: AnalysisFragment
  -> merged: AnalysisFragment
  = @review.report_merge {
    fragments = [mechanism_fragment, timing_fragment, beneficiaries_fragment];
  };

node review
  <- merged: AnalysisFragment
  -> concerns: ReviewConcerns | review_error: ExecutorError
  = @review.review merged;

node rewriter
  <- merged: AnalysisFragment
  <- concerns: ReviewConcerns
  -> bundle: ReviewBundle | rewriter_error: ExecutorError
  = @review.rewriter {
    analysis = merged;
    inherit concerns;
  };

node error_sink
  <- planner_error: ExecutorError
  <- gatherer_mechanism_error: ExecutorError
  <- gatherer_timing_error: ExecutorError
  <- gatherer_beneficiaries_error: ExecutorError
  <- analyst_mechanism_error: ExecutorError
  <- analyst_timing_error: ExecutorError
  <- analyst_beneficiaries_error: ExecutorError
  <- review_error: ExecutorError
  <- rewriter_error: ExecutorError
  = @artifact.log {
    errors = [
      planner_error,
      gatherer_mechanism_error,
      gatherer_timing_error,
      gatherer_beneficiaries_error,
      analyst_mechanism_error,
      analyst_timing_error,
      analyst_beneficiaries_error,
      review_error,
      rewriter_error,
    ];
  };

node report
  <- bundle: ReviewBundle
  -> artifact: ReportArtifactRef
  = @cortex.deep_report {
    title = "Thesis Parallel Claim Branches";
    description = "Structural experiment in claim-scoped analyst branching.";
    match.skill = "deep-report";
    match.priority = 105;
    match.requestContainsAny = [
      "parallel claim branches",
      "claim-scoped analysts",
    ];
    render.aggregateOpenGaps = true;
    render.allowExtraSectionHeadings = true;
    workspace.sourceKind = "deep-report";
    payload = bundle;
  };

# ---- the wire ----

let branches =
  planner
    => (
      (gatherer_mechanism
        => analyst_mechanism)
      <> (gatherer_timing
        => analyst_timing)
      <> (gatherer_beneficiaries
        => analyst_beneficiaries)
  );

let thesis =
  branches
    => merge
    => review
    => rewriter;

thesis
  => (report <> error_sink)
